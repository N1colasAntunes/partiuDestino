@using projectPartiuDestino.Models
@model projectPartiuDestino.Models.Pacotes

@{
    ViewData["Title"] = $"{Model.Nome}";

    var voo = ViewBag.Voo as SelecaoVoo;

    int quantidadeAdultos = voo?.QuantidadeAdultos ?? 1;
    int quantidadeCriancas = voo?.QuantidadeCriancas ?? 0;
    int quantidadeTotal = voo?.QuantidadeTotal ?? 1;
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --text-muted: #6b7280;
        --border: #e5e7eb;
        --bg-soft: #f8fafc;
    }

    .det-pct-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 50px 0 80px;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .det-pct-hero {
        background: linear-gradient(135deg,var(--primary),var(--accent));
        padding: 50px 0 70px;
        color: white;
        text-align: center;
    }

    .det-pct-hero h1 {
        font-size: 2.4rem;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .det-pct-hero p {
        opacity: .95;
        margin: 0;
    }

    .det-pct-resumo {
        max-width: 1100px;
        margin: -40px auto 40px;
        background: white;
        border-radius: 20px;
        padding: 26px 32px;
        box-shadow: 0 12px 30px rgba(0,0,0,.08);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .resumo-item {
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px;
        text-align: center;
    }

    .resumo-item span {
        display: block;
        font-size: .72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .resumo-item strong {
        font-size: 1.02rem;
        color: #1f2937;
    }

    .det-pct-layout {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .alerta-erro {
        background: #fee2e2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 14px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .voo-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 18px 24px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        box-shadow: 0 4px 14px rgba(0,0,0,.04);
    }

    .voo-card-label {
        font-size: .72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 800;
    }

    .voo-card-info {
        font-weight: 800;
        color: #1f2937;
        margin-top: 2px;
    }

    .voo-card-sub {
        font-size: .92rem;
        color: #64748b;
        margin-top: 4px;
    }

    .link-alterar {
        color: var(--accent);
        font-weight: 700;
        font-size: .88rem;
        text-decoration: none;
    }

    .link-alterar:hover {
        text-decoration: underline;
    }

    .det-pct-desc {
        background: white;
        border-radius: 18px;
        padding: 26px;
        margin-bottom: 30px;
        border: 1px solid var(--border);
        color: #374151;
        line-height: 1.7;
        box-shadow: 0 4px 14px rgba(0,0,0,.04);
    }

    .sec-titulo-h {
        font-size: 1.6rem;
        font-weight: 900;
        margin-bottom: 6px;
        color: #1f2937;
    }

    .sec-sub-h {
        color: var(--text-muted);
        margin-bottom: 24px;
        font-size: .98rem;
    }

    .hosp-bloco {
        background: white;
        border-radius: 22px;
        border: 1px solid var(--border);
        margin-bottom: 28px;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(15,23,42,.06);
    }

    .hosp-banner {
        height: 280px;
        position: relative;
        overflow: hidden;
        background: #e5e7eb;
    }

    .hosp-banner-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hosp-banner-fallback {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hosp-banner-fallback i {
        font-size: 3.2rem;
        color: rgba(255,255,255,.35);
    }

    .hosp-conteudo {
        padding: 28px;
    }

    .hosp-topo {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .hosp-topo-esq {
        flex: 1;
        min-width: 260px;
    }

    .hosp-categoria-badge {
        display: inline-block;
        background: #eff6ff;
        color: var(--primary);
        font-size: .72rem;
        font-weight: 800;
        padding: 5px 12px;
        border-radius: 999px;
        margin-bottom: 10px;
    }

    .hosp-conteudo h3 {
        font-size: 1.75rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 8px;
    }

    .hosp-end {
        font-size: .95rem;
        color: #64748b;
        margin: 0;
    }

    .hosp-avaliacao {
        background: #eff6ff;
        color: #1e3a8a;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        padding: 12px 16px;
        min-width: 130px;
        text-align: center;
    }

    .hosp-avaliacao small {
        display: block;
        font-size: .72rem;
        text-transform: uppercase;
        font-weight: 800;
        color: #64748b;
        margin-bottom: 4px;
    }

    .hosp-avaliacao strong {
        font-size: 1.15rem;
        font-weight: 900;
    }

    .hosp-desc {
        color: #475569;
        line-height: 1.7;
        margin-bottom: 22px;
        font-size: .97rem;
    }

    .hosp-info-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .hosp-info-box {
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px 14px;
        min-height: 88px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: .2s ease;
    }

    .hosp-info-box:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(15,23,42,.06);
    }

    .hosp-info-box span {
        display: block;
        color: #64748b;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 6px;
        letter-spacing: .3px;
    }

    .hosp-info-box strong {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.3;
    }

    .hosp-acoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 8px;
        border-top: 1px solid #edf2f7;
    }

    .hosp-dica {
        color: #64748b;
        font-size: .92rem;
        margin: 0;
        flex: 1;
        min-width: 260px;
    }

    .btn-detalhes-hosp {
        background: linear-gradient(135deg, var(--primary), #2846a8);
        color: white;
        border: none;
        padding: 14px 22px;
        border-radius: 14px;
        font-size: .92rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s;
        box-shadow: 0 8px 20px rgba(30,58,138,.18);
    }

    .btn-detalhes-hosp:hover {
        background: linear-gradient(135deg, #2443a1, var(--accent));
        color: white;
        transform: translateY(-1px);
    }

    .sem-hosp {
        text-align: center;
        padding: 50px 20px;
        background: white;
        border-radius: 18px;
        border: 2px dashed var(--border);
        color: var(--text-muted);
    }

    .sem-hosp h4 {
        color: #1f2937;
        font-weight: 800;
        margin-top: 12px;
    }

    @@media (max-width: 992px) {
        .det-pct-resumo {
            grid-template-columns: repeat(2, 1fr);
        }

        .hosp-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .det-pct-resumo {
            grid-template-columns: 1fr;
        }

        .hosp-banner {
            height: 220px;
        }

        .hosp-conteudo {
            padding: 20px;
        }

        .hosp-conteudo h3 {
            font-size: 1.45rem;
        }

        .hosp-info-grid {
            grid-template-columns: 1fr;
        }

        .hosp-acoes {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-detalhes-hosp {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<div class="det-pct-page">

    <div class="det-pct-hero">
        <h1>@Model.Nome</h1>
        <p>@Model.TipoViagem · @Model.DuracaoDias dias</p>
    </div>

    <div class="det-pct-resumo">
        <div class="resumo-item">
            <span>Partida</span>
            <strong>@Model.DataPartida.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="resumo-item">
            <span>Retorno</span>
            <strong>@Model.DataRetorno.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="resumo-item">
            <span>Vagas</span>
            <strong>@Model.VagasDisponiveis</strong>
        </div>

        <div class="resumo-item">
            <span>Preço base / pessoa</span>
            <strong style="color:var(--primary);">@Model.PrecoPorPessoa.ToString("C")</strong>
        </div>
    </div>

    <div class="det-pct-layout">

        @if (TempData["Erro"] != null)
        {
            <div class="alerta-erro">
                <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
            </div>
        }
        @if (voo != null)
        {
            <div class="voo-card">
                <div>
                    <span class="voo-card-label">Passagem selecionada</span>

                    <div class="voo-card-info">
                        <i class="fas fa-plane" style="color:var(--accent);"></i>
                        @voo.CompanhiaAerea — @voo.TituloVoo · Classe @voo.ClasseViagem
                    </div>

                    <div class="voo-card-sub">
                        @voo.AeroportoOrigem → @voo.AeroportoDestino
                    </div>

                    <div class="voo-card-sub">
                        Ida: @voo.HorarioIda · Volta: @voo.HorarioVolta · Duração: @voo.DuracaoMedia
                    </div>

                    <div class="voo-card-sub">
                        @voo.BagagemInclusa · @voo.TipoTarifa · @voo.Escala
                    </div>

                    <div class="voo-card-sub">
                        Assentos: @voo.NumeroAssento
                    </div>

                    <div class="voo-card-sub">
                        @quantidadeAdultos adulto(s), @quantidadeCriancas criança(s)
                        — Total: @quantidadeTotal viajante(s)
                    </div>

                    @if (voo.PrecoAdicional > 0)
                    {
                        <div class="voo-card-sub" style="color:var(--success);font-weight:800;">
                            Adicionais da passagem: @voo.PrecoAdicional.ToString("C")
                        </div>
                    }
                </div>

                <a asp-controller="Pacotes"
                   asp-action="Passagem"
                   asp-route-id="@Model.Id"
                   class="link-alterar">
                    <i class="fas fa-edit"></i> Alterar passagem
                </a>
            </div>
        }

        <div class="det-pct-desc">
            @Model.Descricao
        </div>

        <h2 class="sec-titulo-h">Hospedagem do pacote</h2>
        <p class="sec-sub-h">
            Veja os detalhes da hospedagem, horários, regras e quartos disponíveis antes de escolher.
        </p>

        @if (Model.Hospedagens == null || !Model.Hospedagens.Any())
        {
            <div class="sem-hosp">
                <i class="fas fa-bed fa-3x" style="color:#cbd5e1;"></i>
                <h4>Nenhuma hospedagem cadastrada ainda</h4>
                <p>Este pacote ainda não possui uma hospedagem vinculada.</p>
            </div>
        }
        else
        {
            @foreach (var hosp in Model.Hospedagens)
            {
                <div class="hosp-bloco">

                    <div class="hosp-banner">
                        @if (!string.IsNullOrEmpty(hosp.ImagemUrl))
                        {
                            <img src="@hosp.ImagemUrl"
                                 alt="@hosp.Nome"
                                 class="hosp-banner-img"
                                 loading="lazy"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                            <div class="hosp-banner-fallback" style="display:none;">
                                <i class="fas fa-hotel"></i>
                            </div>
                        }
                        else
                        {
                            <div class="hosp-banner-fallback">
                                <i class="fas fa-hotel"></i>
                            </div>
                        }
                    </div>

                    <div class="hosp-conteudo">

                        <div class="hosp-topo">
                            <div class="hosp-topo-esq">
                                @if (!string.IsNullOrEmpty(hosp.Categoria))
                                {
                                    <span class="hosp-categoria-badge">
                                        @hosp.Categoria
                                    </span>
                                }

                                <h3>@hosp.Nome</h3>

                                @if (!string.IsNullOrEmpty(hosp.Endereco))
                                {
                                    <p class="hosp-end">
                                        <i class="fas fa-map-marker-alt"></i> @hosp.Endereco
                                    </p>
                                }
                            </div>

                            @if (hosp.Avaliacao != null)
                            {
                                <div class="hosp-avaliacao">
                                    <small>Avaliação</small>
                                    <strong>@hosp.Avaliacao / 10</strong>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(hosp.Descricao))
                        {
                            <p class="hosp-desc">
                                @hosp.Descricao
                            </p>
                        }

                        <div class="hosp-info-grid">
                            <div class="hosp-info-box">
                                <span>Check-in</span>
                                <strong>A partir das @hosp.Checkin</strong>
                            </div>

                            <div class="hosp-info-box">
                                <span>Check-out</span>
                                <strong>Até @hosp.Checkout</strong>
                            </div>

                            <div class="hosp-info-box">
                                <span>Café</span>
                                <strong>@(hosp.CafeIncluso ? "Incluso" : "Não incluso")</strong>
                            </div>

                            <div class="hosp-info-box">
                                <span>Wi-Fi</span>
                                <strong>@(hosp.WifiIncluso ? "Incluso" : "Não incluso")</strong>
                            </div>

                            <div class="hosp-info-box">
                                <span>Estacionamento</span>
                                <strong>@(hosp.Estacionamento ? "Disponível" : "Não incluso")</strong>
                            </div>
                        </div>

                        <div class="hosp-acoes">
                            <p class="hosp-dica">
                                Veja todos os detalhes da hospedagem, quartos disponíveis, políticas e escolha a melhor opção para sua viagem.
                            </p>

                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <a asp-controller="Pacotes"
                                   asp-action="DetalhesHospedagem"
                                   asp-route-pacoteId="@Model.Id"
                                   asp-route-hospedagemId="@hosp.Id"
                                   class="btn-detalhes-hosp">
                                   
                                    Ver detalhes e escolher quarto
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Login"
                                   asp-action="Index"
                                   class="btn-detalhes-hosp">
                                    <i class="fas fa-sign-in-alt"></i>
                                    Entrar para continuar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>