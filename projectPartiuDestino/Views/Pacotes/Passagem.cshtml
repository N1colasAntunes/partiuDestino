@model projectPartiuDestino.Models.Pacotes
@{
    ViewData["Title"] = $"Passagem - {Model.Nome}";
    var assentosOcupados = ViewBag.AssentosOcupados as List<string> ?? new List<string>();
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --text-muted: #6b7280;
        --border: #e5e7eb;
        --occupied: #d1d5db;
        --selected: #3b82f6;
        --available: #ffffff;
    }

    .voo-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 50px 0 80px;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .voo-hero {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        padding: 50px 0 70px;
        color: white;
        text-align: center;
    }

        .voo-hero h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .voo-hero p {
            opacity: .9;
        }

    .voo-resumo {
        max-width: 800px;
        margin: -40px auto 40px;
        background: white;
        border-radius: 18px;
        padding: 24px 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .resumo-rota {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
        color: #1f2937;
    }

        .resumo-rota i {
            color: var(--accent);
        }

    .resumo-datas {
        display: flex;
        gap: 24px;
        font-size: .85rem;
        color: var(--text-muted);
    }

        .resumo-datas strong {
            color: #1f2937;
            display: block;
        }

    .voo-layout {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .card-secao-voo {
        background: white;
        border-radius: 18px;
        padding: 32px;
        margin-bottom: 24px;
        border: 1px solid var(--border);
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

        .card-secao-voo h3 {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 18px;
            color: #1f2937;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .opcoes-classe {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .opcao-classe input {
        display: none;
    }

    .opcao-classe-label {
        display: block;
        border: 2px solid var(--border);
        border-radius: 14px;
        padding: 18px;
        text-align: center;
        cursor: pointer;
        transition: .2s;
    }

        .opcao-classe-label .nome-classe {
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 6px;
            display: block;
        }

        .opcao-classe-label .preco-classe {
            font-size: .85rem;
            color: var(--success);
            font-weight: 700;
        }

    .opcao-classe input:checked + .opcao-classe-label {
        border-color: var(--primary);
        background: #eff6ff;
    }

    /* Mapa de Assentos */
    .airplane-map {
        background: #f1f5f9;
        border-radius: 50px 50px 20px 20px;
        padding: 40px 20px;
        max-width: 500px;
        margin: 0 auto;
        border: 2px solid #e2e8f0;
    }

    .airplane-header {
        text-align: center;
        margin-bottom: 30px;
        color: var(--text-muted);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .seat-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr); /* A B C [espaço] D E F */
        gap: 10px;
        align-items: center;
    }

    .seat-row-num {
        grid-column: 4;
        text-align: center;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 700;
    }

    .seat {
        width: 35px;
        height: 35px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.7rem;
        font-weight: 700;
        transition: all 0.2s;
        background: var(--available);
    }

        .seat:hover:not(.occupied) {
            border-color: var(--accent);
            background: #f0f9ff;
        }

        .seat.occupied {
            background: var(--occupied);
            cursor: not-allowed;
            color: #9ca3af;
            border-color: #d1d5db;
            position: relative;
        }

            .seat.occupied::after {
                content: 'X';
                position: absolute;
                font-size: 1rem;
                color: #6b7280;
            }

        .seat.selected {
            background: var(--selected);
            border-color: var(--primary);
            color: white;
        }

    .seat-legend {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .legend-box {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
    }

    .btn-continuar-voo {
        width: 100%;
        background: linear-gradient(135deg, var(--primary), #1e40af);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 14px;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: .2s;
        margin-top: 20px;
    }

        .btn-continuar-voo:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(30,58,138,.25);
        }

    @@media (max-width:700px) {
        .opcoes-classe {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="voo-page">

    <div class="voo-hero">
        <h1><i class="fas fa-plane-departure"></i> Escolha sua Passagem</h1>
        <p>Etapa 1 de 3 — Pacote selecionado: @Model.Nome</p>
    </div>

    <div class="voo-resumo">
        <div class="resumo-rota">
            <i class="fas fa-map-marker-alt"></i> @ViewBag.OrigemEstado - @ViewBag.OrigemPais
            <i class="fas fa-arrow-right"></i> @ViewBag.DestinoEstado - @ViewBag.DestinoPais
        </div>
        <div class="resumo-datas">
            <div><strong>Ida</strong>@Model.DataPartida.ToString("dd/MM/yyyy")</div>
            <div><strong>Volta</strong>@Model.DataRetorno.ToString("dd/MM/yyyy")</div>
            <div><strong>Duração</strong>@Model.DuracaoDias dias</div>
        </div>
    </div>

    <div class="voo-layout">

        @if (TempData["Erro"] != null)
        {
            <div style="background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;padding:14px 20px;border-radius:12px;margin-bottom:20px;font-weight:600;">
                <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
            </div>
        }

        <form method="post" asp-action="Passagem" id="formVoo">
            <input type="hidden" name="pacoteId" value="@Model.Id" />
            <input type="hidden" name="numeroAssento" id="inputAssento" value="" />
            <input type="hidden" name="tipoAssento" id="inputTipoAssento" value="Janela" />

            <div class="card-secao-voo">
                <h3><i class="fas fa-chair" style="color:var(--accent);"></i> Classe de Viagem</h3>
                <div class="opcoes-classe">
                    <div class="opcao-classe">
                        <input type="radio" name="classeViagem" id="classeEco" value="Econômica" checked />
                        <label class="opcao-classe-label" for="classeEco">
                            <span class="nome-classe">Econômica</span>
                            <span class="preco-classe">Incluído no pacote</span>
                        </label>
                    </div>
                    <div class="opcao-classe">
                        <input type="radio" name="classeViagem" id="classeExec" value="Executiva" />
                        <label class="opcao-classe-label" for="classeExec">
                            <span class="nome-classe">Executiva</span>
                            <span class="preco-classe">+ R$ 450,00 /pessoa</span>
                        </label>
                    </div>
                    <div class="opcao-classe">
                        <input type="radio" name="classeViagem" id="classePrim" value="Primeira Classe" />
                        <label class="opcao-classe-label" for="classePrim">
                            <span class="nome-classe">Primeira Classe</span>
                            <span class="preco-classe">+ R$ 1.200,00 /pessoa</span>
                        </label>
                    </div>
                </div>

                <h3><i class="fas fa-couch" style="color:var(--accent);"></i> Selecione seu Assento</h3>

                <div class="airplane-map">
                    <div class="airplane-header">Cabine de Passageiros</div>

                    <div class="seat-grid">
                        <!-- Cabeçalho das colunas -->
                        <div style="text-align:center;font-weight:bold;">A</div>
                        <div style="text-align:center;font-weight:bold;">B</div>
                        <div style="text-align:center;font-weight:bold;">C</div>
                        <div></div>
                        <div style="text-align:center;font-weight:bold;">D</div>
                        <div style="text-align:center;font-weight:bold;">E</div>
                        <div style="text-align:center;font-weight:bold;">F</div>

                        @for (int i = 1; i <= 10; i++)
                        {
                            string[] cols = { "A", "B", "C", "D", "E", "F" };
                            int colIdx = 0;
                            foreach (var col in cols)
                            {
                                string seatId = $"{i}{col}";
                                bool isOccupied = assentosOcupados.Contains(seatId);
                                string seatType = (col == "A" || col == "F") ? "Janela" : (col == "C" || col == "D" ? "Corredor" : "Meio");

                                <div class="seat @(isOccupied ? "occupied" : "")"
                                     data-seat="@seatId"
                                     data-type="@seatType"
                                     onclick="selectSeat(this)">
                                    @seatId
                                </div>

                                if (col == "C")
                                {
                                    <div class="seat-row-num">@i</div>
                                }
                            }
                        }
                    </div>

                    <div class="seat-legend">
                        <div class="legend-item"><div class="legend-box" style="background:var(--available);"></div> Disponível</div>
                        <div class="legend-item"><div class="legend-box" style="background:var(--occupied);"></div> Ocupado</div>
                        <div class="legend-item"><div class="legend-box" style="background:var(--selected);"></div> Selecionado</div>
                    </div>
                </div>

                <div id="seat-info" style="margin-top:20px; text-align:center; font-weight:700; color:var(--primary); display:none;">
                    Assento Selecionado: <span id="selected-seat-display">--</span>
                    (<span id="selected-type-display">--</span>)
                </div>

                <button type="submit" class="btn-continuar-voo">
                    Continuar para Hospedagem <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </form>

    </div>
</div>

<script>
    function selectSeat(element) {
        if (element.classList.contains('occupied')) return;

        // Remover seleção anterior
        document.querySelectorAll('.seat.selected').forEach(s => s.classList.remove('selected'));

        // Adicionar nova seleção
        element.classList.add('selected');

        // Atualizar inputs escondidos
        const seatId = element.getAttribute('data-seat');
        const seatType = element.getAttribute('data-type');

        document.getElementById('inputAssento').value = seatId;
        document.getElementById('inputTipoAssento').value = seatType;

        // Mostrar info
        document.getElementById('seat-info').style.display = 'block';
        document.getElementById('selected-seat-display').innerText = seatId;
        document.getElementById('selected-type-display').innerText = seatType;
    }

    // Validação básica antes de enviar
    document.getElementById('formVoo').onsubmit = function(e) {
        if (!document.getElementById('inputAssento').value) {
            alert('Por favor, selecione um assento no mapa antes de continuar.');
            return false;
        }
        return true;
    };
</script>