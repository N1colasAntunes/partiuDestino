@model IEnumerable<projectPartiuDestino.Models.Pacotes>

@{
    ViewData["Title"] = "Pacotes de Viagem";

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .pacotes-container {
        background-color: var(--bg-body);
        overflow: visible !important;
        padding: 60px 0;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .header-secao {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-secao h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .header-secao p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

    .pacotes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 30px;
    }

    /* ── Card ── */
    .card-pacote-premium {
        background: var(--white);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,.05);
        border: 1px solid var(--border);
        transition: transform .3s, box-shadow .3s;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .card-pacote-premium:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 25px rgba(0,0,0,.10);
        }

    /* ── Topo com imagem própria do pacote ── */
    .pacote-topo {
        height: 200px;
        position: relative;
        overflow: hidden;
    }

    .pacote-topo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .4s ease;
    }

    .card-pacote-premium:hover .pacote-topo-img {
        transform: scale(1.06);
    }

    .pacote-topo-fallback {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pacote-topo-fallback i {
            font-size: 4rem;
            color: rgba(255,255,255,.25);
        }

    .pacote-topo-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,.18) 0%, rgba(0,0,0,0) 55%);
    }

    .badge-vagas {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 6px 12px;
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 700;
        color: white;
        z-index: 2;
        backdrop-filter: blur(4px);
        box-shadow: 0 2px 8px rgba(0,0,0,.2);
    }

    .vagas-ok {
        background: rgba(16,185,129,.9);
    }

    .vagas-alerta {
        background: rgba(245,158,11,.9);
    }

    .vagas-esgotado {
        background: rgba(239,68,68,.9);
    }

    .badge-tipo {
        position: absolute;
        bottom: 14px;
        left: 14px;
        background: rgba(255,255,255,.2);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 700;
        backdrop-filter: blur(4px);
        z-index: 2;
    }

    /* ── Conteúdo ── */
    .pacote-conteudo {
        padding: 22px 24px;
        flex-grow: 1;
    }

    .pacote-titulo {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 14px;
        line-height: 1.25;
    }

    .pacote-detalhes-rapidos {
        display: flex;
        justify-content: space-between;
        background: #f9fafb;
        padding: 11px 14px;
        border-radius: 12px;
        margin-bottom: 16px;
    }

    .detalhe-item {
        text-align: center;
    }

    .detalhe-label {
        display: block;
        font-size: .62rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .detalhe-valor {
        font-size: .82rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .pacote-descricao {
        font-size: .87rem;
        color: var(--text-muted);
        line-height: 1.55;
        margin-bottom: 16px;
    }

    /* ── Footer ── */
    .pacote-footer {
        padding: 18px 24px;
        background: #fcfcfd;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pacote-preco-box {
        display: flex;
        flex-direction: column;
    }

    .preco-sub {
        font-size: .68rem;
        color: var(--text-muted);
    }

    .preco-principal {
        font-size: 1.45rem;
        font-weight: 900;
        color: var(--primary);
    }

    .btn-reservar {
        background: var(--primary);
        color: white;
        padding: 10px 30px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .88rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: background .25s, transform .2s;
    }

        .btn-reservar:hover {
            background: var(--accent);
            color: white;
            transform: scale(1.04);
        }

        .btn-reservar.disabled {
            background: #94a3b8;
            cursor: not-allowed;
            pointer-events: none;
        }

    .lista-vazia {
        grid-column: 1/-1;
        text-align: center;
        padding: 100px 20px;
        background: white;
        border-radius: 20px;
        border: 2px dashed var(--border);
    }

    @@media (max-width:768px) {
        .pacotes-grid {
            grid-template-columns: 1fr;
        }
    }

    .search-container {
        position: relative;
        max-width: 500px;
        margin: 30px auto;
    }

        .search-container input {
            width: 100%;
            padding: 14px 20px;
            padding-right: 50px;
            border: none;
            border-radius: 50px;
            background: white;
            box-shadow: 0 5px 15px rgba(0,0,0,.1);
            font-size: 16px;
            outline: none;
            transition: .3s;
        }

            .search-container input:focus {
                box-shadow: 0 5px 20px rgba(59,130,246,.3);
            }

        .search-container i {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #3b82f6;
        }

    .btn-detalhes {
        background: white;
        color: var(--primary);
        border: 2px solid var(--primary);
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        white-space: nowrap;
    }

        .btn-detalhes:hover {
            background: var(--primary);
            color: white;
        }

    .pacote-acoes {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

</style>

<div class="pacotes-container">
    <div class="container">
        <div class="search-container">
            <input type="text"
                   id="campoBuscaPacotes"
                   placeholder="Pesquisar pacote, descrição ou tipo de viagem...">

            <i class="fas fa-search"></i>
        </div>

        <div class="header-secao">
            <h1>Nossos Pacotes</h1>
            <p>Roteiros exclusivos planejados para que você só se preocupe em aproveitar cada segundo da sua viagem.</p>
        </div>

        <div class="pacotes-grid">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    // Imagem própria do pacote — sem precisar buscar do destino
                    string imgUrl = string.IsNullOrEmpty(item.ImagemUrl) ? "" :
                    item.ImagemUrl + (item.ImagemUrl.Contains("unsplash.com") && !item.ImagemUrl.Contains("?") ? "?w=700&q=80" : "");
                    bool temImagem = !string.IsNullOrEmpty(imgUrl);

                    string vagasCss = item.VagasDisponiveis > 5 ? "vagas-ok"
                    : item.VagasDisponiveis > 0 ? "vagas-alerta"
                    : "vagas-esgotado";
                    string vagasTxt = item.VagasDisponiveis > 5 ? $"{item.VagasDisponiveis} vagas"
                    : item.VagasDisponiveis > 0 ? $"Últimas {item.VagasDisponiveis}!"
                    : "Esgotado";
                    bool esgotado = item.VagasDisponiveis == 0;

                    <div class="card-pacote-premium">

                        <!-- Topo com imagem própria do pacote -->
                        <div class="pacote-topo">
                            @if (temImagem)
                            {
                                <img class="pacote-topo-img"
                                     src="@imgUrl"
                                     alt="@item.Nome"
                                     loading="lazy"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="pacote-topo-fallback" style="display:none;">
                                    <i class="fas fa-plane-departure"></i>
                                </div>
                            }
                            else
                            {
                                <div class="pacote-topo-fallback">
                                    <i class="fas fa-plane-departure"></i>
                                </div>
                            }
                            <div class="pacote-topo-overlay"></div>
                            <span class="badge-vagas @vagasCss">@vagasTxt</span>
                            @if (!string.IsNullOrEmpty(item.TipoViagem))
                            {
                                <span class="badge-tipo">@item.TipoViagem</span>
                            }
                    </div>

                    <!-- Conteúdo -->
                    <div class="pacote-conteudo">
                        <h3 class="pacote-titulo">@item.Nome</h3>

                        <div class="pacote-detalhes-rapidos">
                            <div class="detalhe-item">
                                <span class="detalhe-label">Duração</span>
                                <span class="detalhe-valor">@item.DuracaoDias dias</span>
                            </div>
                            <div class="detalhe-item">
                                <span class="detalhe-label">Partida</span>
                                <span class="detalhe-valor">@item.DataPartida.ToString("dd/MM/yy")</span>
                            </div>
                            <div class="detalhe-item">
                                <span class="detalhe-label">Retorno</span>
                                <span class="detalhe-valor">@item.DataRetorno.ToString("dd/MM/yy")</span>
                            </div>
                        </div>

                        <p class="pacote-descricao">
                            @(item.Descricao?.Length > 120
                                                    ? item.Descricao.Substring(0, 120) + "…"
                                                    : item.Descricao)
                    </p>
                </div>

                        <div class="pacote-footer">
                            <div class="pacote-preco-box">
                                <span class="preco-sub">Por pessoa</span>
                                <span class="preco-principal">@item.PrecoPorPessoa.ToString("C")</span>
                            </div>

                            <div class="pacote-acoes">
                                <a asp-controller="Pacotes" asp-action="Detalhes" asp-route-id="@item.Id" class="btn-detalhes">
                                  Detalhes
                                </a>

                        @if (Context.Session.GetString("UserName") != null)
                                {
                                    if (!esgotado)
                                    {
                                        <form asp-controller="Carrinho" asp-action="AdicionarPacote"
                                              method="post" style="margin:0;">
                                            <input type="hidden" name="pacoteId" value="@item.Id" />
                                            <button type="submit" class="btn-reservar">
                                                <i class="fas fa-cart-plus"></i> Adicionar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn-reservar disabled">Esgotado</span>
                                    }
                                }
                                else
                                {
                                    <a asp-controller="Login" asp-action="Index" class="btn-reservar">
                                        <i class="fas fa-sign-in-alt"></i> Entre para Reservar
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="lista-vazia">
                    <i class="fas fa-suitcase-rolling fa-4x mb-4" style="color:#cbd5e1;"></i>
                    <h3>Nenhum pacote encontrado</h3>
                    <p>Estamos preparando novas aventuras. Volte em breve!</p>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-primary mt-3 px-4 py-2 rounded-pill">Voltar ao Início</a>
                </div>
            }

        </div>
    </div>
</div>
<footer class="footer-figma">
    <div class="container">
        <div class="footer-links-sociais">
            <span>Siga nossas redes:</span>
            <a href="https://www.instagram.com/_partiu.destino/"><i class="fab fa-instagram"></i></a>
            <a href="https://www.facebook.com/people/Partiu-Destino/61590693054759/"><i class="fab fa-facebook"></i></a>
            <a href="https://wa.me/5511981125234" target="_blank"><i class="fab fa-whatsapp"></i></a>
        </div>
        <p>
            &copy; 2026 Partiu Destino. Todos os direitos reservados. |
            <a href="/Legal/PoliticaDePrivacidade" style="color:white;">Política de Privacidade</a> |
            <a href="/Legal/TermosDeUso" style="color:white;">Termos de Uso</a>
        </p>
    </div>
</footer>
<script>
    const pesquisaPacote =
        document.getElementById("campoBuscaPacotes");

    pesquisaPacote.addEventListener("keyup", function () {

        let termo = this.value.trim();

        if (termo.length < 2) {
            document.getElementById(
                "resultadoPesquisaPacotes"
            ).innerHTML = "";

            return;
        }

        fetch('/Pacotes/Buscar?termo=' +
              encodeURIComponent(termo))

            .then(response => response.text())

            .then(html => {

                document.getElementById(
                    "resultadoPesquisaPacotes"
                ).innerHTML = html;

            });

    });
</script>