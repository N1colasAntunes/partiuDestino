@{
    ViewData["Title"] = "Editar Quarto";
}

<style>
    .form-wrapper {
        max-width: 700px;
        margin: 40px auto;
        padding: 0 20px;
    }

    form {
        background: white;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,.1);
        display: grid;
        gap: 18px;
    }

    label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
        display: block;
        font-size: .9rem;
    }

    input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        box-sizing: border-box;
    }

    button[type="submit"] {
        padding: 14px;
        background: #1e3a8a;
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
    }
</style>

<div class="form-wrapper">
    <h2 style="color:#1e3a8a;font-weight:800;">Editar Quarto</h2>
    <a href="/QuartosAdmin/Index?hospedagemId=@ViewBag.HospedagemId" style="color:#1e3a8a;font-weight:700;">&#8592; Voltar</a>
    <form method="post" asp-action="Editar" style="margin-top:20px;">
        <input type="hidden" name="id" value="@ViewBag.Id" />
        <input type="hidden" name="hospedagemId" value="@ViewBag.HospedagemId" />
        <div><label>Tipo de Quarto</label><input type="text" name="tipoQuarto" value="@ViewBag.TipoQuarto" required /></div>
        <div><label>Capacidade de Adultos</label><input type="number" name="capacidadeAdultos" value="@ViewBag.CapacidadeAdultos" min="1" required /></div>
        <div><label>Capacidade de Crianças</label><input type="number" name="capacidadeCriancas" value="@ViewBag.CapacidadeCriancas" min="0" required /></div>
        <div><label>Valor Extra por Pessoa (R$)</label><input type="number" step="0.01" name="precoAdicional" value="@ViewBag.PrecoAdicional" required /></div>
        <div><label>Quantidade Disponível</label><input type="number" name="quantidadeDisponivel" value="@ViewBag.QuantidadeDisponivel" min="0" required /></div>
        <div><label>Comodidades</label><input type="text" name="comodidades" value="@ViewBag.Comodidades" /></div>
        <div><label>URL da Imagem</label><input type="text" name="imagemUrl" value="@ViewBag.ImagemUrl" /></div>
        <button type="submit">Salvar Alterações</button>
    </form>
</div>