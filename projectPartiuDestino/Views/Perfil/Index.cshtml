@model List<projectPartiuDestino.Models.PedidoConfirmado>

@{
    ViewData["Title"] = "Meu Perfil";
    string tipo = ViewBag.Tipo ?? "usuario";
    bool isAdmin = tipo == "admin";
    string fotoPerfil = ViewBag.FotoPerfil;
    bool temFoto = !string.IsNullOrEmpty(fotoPerfil);
    string dataNasc = ViewBag.DataNascimento is DateTime dn
                            ? dn.ToString("dd/MM/yyyy") : "—";
}

<style>
    :root {
        --azul: #1e3a8a;
        --azul-medio: #2563eb;
        --cinza-bg: #f1f5f9;
        --cinza-borda: #e2e8f0;
        --texto: #1e293b;
        --sub: #64748b;
        --branco: #ffffff;
        --verde: #16a34a;
        --laranja: #d97706;
    }

    body {
        background: var(--cinza-bg);
    }

    /* ── layout ── */
    .perfil-wrap {
        max-width: 1100px;
        margin: 36px auto 60px;
        padding: 0 16px;
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 24px;
    }

    @@media (max-width: 860px) {
        .perfil-wrap {
            grid-template-columns: 1fr;
        }
    }

    /* ── sidebar ── */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .card {
        background: var(--branco);
        border-radius: 14px;
        border: 1px solid var(--cinza-borda);
        overflow: hidden;
    }

    .card-body {
        padding: 24px;
    }

    /* foto */
    .foto-wrap {
        position: relative;
        width: 96px;
        height: 96px;
        margin: 0 auto 16px;
    }

        .foto-wrap img,
        .foto-wrap .avatar-inicial {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--cinza-borda);
        }

    .avatar-inicial {
        background: var(--azul);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -1px;
    }

    .btn-foto-label {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 30px;
        height: 30px;
        background: var(--azul-medio);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: .75rem;
        cursor: pointer;
        border: 2px solid white;
        transition: background .2s;
    }

        .btn-foto-label:hover {
            background: var(--azul);
        }

    #inputFoto {
        display: none;
    }

    .perfil-nome {
        text-align: center;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--texto);
        margin-bottom: 2px;
    }

    .perfil-email {
        text-align: center;
        font-size: .82rem;
        color: var(--sub);
        margin-bottom: 14px;
    }

    .badge-tipo {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .75rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        margin: 0 auto 16px;
    }

    .badge-admin {
        background: #eff6ff;
        color: var(--azul);
    }

    .badge-usuario {
        background: #f0fdf4;
        color: var(--verde);
    }

    /* dados pessoais na sidebar */
    .info-lista {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .info-lista li {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 9px 0;
            border-bottom: 1px solid var(--cinza-borda);
            font-size: .84rem;
            gap: 10px;
        }

            .info-lista li:last-child {
                border-bottom: none;
            }

        .info-lista .label {
            color: var(--sub);
            font-weight: 600;
            white-space: nowrap;
        }

        .info-lista .valor {
            color: var(--texto);
            text-align: right;
            word-break: break-word;
        }

    .btn-editar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 10px;
        background: var(--azul);
        color: white;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 700;
        font-size: .88rem;
        margin-top: 16px;
        transition: background .2s;
    }

        .btn-editar:hover {
            background: var(--azul-medio);
            color: white;
        }

    /* admin atalhos */
    .atalhos-admin a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--cinza-borda);
        color: var(--texto);
        text-decoration: none;
        font-size: .88rem;
        font-weight: 600;
        transition: background .15s;
    }

        .atalhos-admin a:last-child {
            border-bottom: none;
        }

        .atalhos-admin a:hover {
            background: var(--cinza-bg);
        }

    .atalhos-admin .icon-a {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        flex-shrink: 0;
    }

    .ic-azul {
        background: #eff6ff;
        color: var(--azul-medio);
    }

    .ic-verde {
        background: #f0fdf4;
        color: var(--verde);
    }

    .ic-roxo {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .ic-laranja {
        background: #fff7ed;
        color: var(--laranja);
    }

    /* ── conteúdo principal ── */
    .main {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    /* alerta sucesso */
    .alerta-sucesso {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
        padding: 12px 18px;
        border-radius: 10px;
        font-size: .9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* seção de pedidos */
    .secao-titulo {
        font-size: 1rem;
        font-weight: 700;
        color: var(--texto);
        padding: 18px 22px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .secao-titulo span {
            color: var(--sub);
            font-weight: 400;
            font-size: .85rem;
        }

    /* tabela de pedidos */
    .tabela-pedidos {
        width: 100%;
        border-collapse: collapse;
        font-size: .87rem;
    }

        .tabela-pedidos thead th {
            background: var(--cinza-bg);
            color: var(--sub);
            font-weight: 700;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 10px 16px;
            text-align: left;
            border-bottom: 1px solid var(--cinza-borda);
        }

        .tabela-pedidos tbody td {
            padding: 13px 16px;
            border-bottom: 1px solid var(--cinza-borda);
            color: var(--texto);
            vertical-align: middle;
        }

        .tabela-pedidos tbody tr:last-child td {
            border-bottom: none;
        }

        .tabela-pedidos tbody tr:hover td {
            background: #f8fafc;
        }

    .badge-tipo-item {
        font-size: .72rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        display: inline-block;
    }

    .badge-pacote {
        background: #eff6ff;
        color: var(--azul-medio);
    }

    .badge-destino {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .badge-outro {
        background: #f1f5f9;
        color: var(--sub);
    }

    .preco-destaque {
        font-weight: 700;
        color: var(--azul);
    }

    .vazio {
        padding: 40px 24px;
        text-align: center;
        color: var(--sub);
        font-size: .92rem;
    }

        .vazio i {
            font-size: 2.5rem;
            margin-bottom: 10px;
            display: block;
            color: var(--cinza-borda);
        }
</style>

@* alerta de sucesso *@
@if (!string.IsNullOrEmpty(ViewBag.Sucesso as string))
{
    <div style="max-width:1100px;margin:20px auto 0;padding:0 16px;">
        <div class="alerta-sucesso">
            <i class="fas fa-check-circle"></i>
            @ViewBag.Sucesso
        </div>
    </div>
}

@* alerta de erro *@
@if (!string.IsNullOrEmpty(ViewBag.Erro as string))
{
    <div style="max-width:1100px;margin:20px auto 0;padding:0 16px;">
        <div style="background:#fee2e2;border:1px solid #fca5a5;color:#b91c1c;padding:12px 16px;border-radius:8px;display:flex;align-items:center;gap:10px;">
            <i class="fas fa-exclamation-circle"></i>
            @ViewBag.Erro
        </div>
    </div>
}

<div class="perfil-wrap">

    <!-- ════════════ SIDEBAR ════════════ -->
    <aside class="sidebar">

        <!-- Card: foto + dados resumidos -->
        <div class="card">
            <div class="card-body" style="text-align:center;">

                <!-- Foto e botão de alterar -->
                <form asp-action="AlterarFoto" asp-controller="Perfil"
                      method="post" enctype="multipart/form-data" id="formFoto">
                    <div class="foto-wrap">
                        @if (temFoto)
                        {
                            <img src="@fotoPerfil" alt="Foto de perfil" width="96" height="96" />
                        }
                        else
                        {
                            <div class="avatar-inicial">
                                @(ViewBag.Nome?.ToString().Substring(0, 1).ToUpper())
                            </div>
                        }
                        <label class="btn-foto-label" for="inputFoto" title="Alterar foto">
                            <i class="fas fa-camera"></i>
                        </label>
                        <input type="file" id="inputFoto" name="foto"
                               accept=".jpg,.jpeg,.png,.webp"
                               style="display:none"
                               onchange="document.getElementById('formFoto').submit()" />
                    </div>
                </form>

                <div class="perfil-nome">@ViewBag.Nome</div>
                <div class="perfil-email">@ViewBag.Email</div>

                <div style="display:flex;justify-content:center;">
                    @if (isAdmin)
                    {
                        <span class="badge-tipo badge-admin">
                            <i class="fas fa-shield-alt"></i> Administrador
                        </span>
                    }
                    else
                    {
                        <span class="badge-tipo badge-usuario">
                            <i class="fas fa-user"></i> Cliente
                        </span>
                    }
                </div>

                <!-- Informações pessoais -->
                <ul class="info-lista" style="margin-top:14px;">
                    <li>
                        <span class="label"><i class="fas fa-user style="width:14px;"></i> Email</span>
                        <span class="valor">@dataNasc</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-pen" style="width:14px;"></i> Nome</span>
                        <span class="valor">@dataNasc</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-phone" style="width:14px;"></i> Telefone</span>
                        <span class="valor">@(string.IsNullOrEmpty(ViewBag.Telefone as string) ? "—" : ViewBag.Telefone)</span>
                    </li>
                    <li>
                        <span class="label"><i class="fas fa-calendar" style="width:14px;"></i> Nascimento</span>
                        <span class="valor">@dataNasc</span>
                    </li>
                </ul>

                <a asp-controller="Perfil" asp-action="Editar" class="btn-editar">
                    <i class="fas fa-pen"></i> Editar perfil
                </a>
            </div>
        </div>

        <!-- Card: atalhos do Admin (só aparece para admins) -->
        @if (isAdmin)
        {
            <div class="card">
                <div class="secao-titulo" style="padding-bottom:10px;">
                    <i class="fas fa-cog" style="color:var(--sub);"></i> Painel Administrativo
                </div>
                <nav class="atalhos-admin">
                    <a href="/Admin/Index">
                        <span class="icon-a ic-azul"><i class="fas fa-chart-pie"></i></span>
                        Dashboard
                    </a>
                    <a href="/Usuarios/Index">
                        <span class="icon-a ic-verde"><i class="fas fa-users"></i></span>
                        Usuários
                    </a>
                    <a href="/PacotesAdmin/Index">
                        <span class="icon-a ic-roxo"><i class="fas fa-suitcase-rolling"></i></span>
                        Pacotes
                    </a>
                    <a href="/DestinosAdmin/Index">
                        <span class="icon-a ic-laranja"><i class="fas fa-map-marked-alt"></i></span>
                        Destinos
                    </a>
                </nav>
            </div>
        }

    </aside>

    <!-- ════════════ CONTEÚDO PRINCIPAL ════════════ -->
    <main class="main">

        <!-- Card: histórico de pedidos -->
        <div class="card">
            <div class="secao-titulo">
                Minhas Reservas
                <span>(@Model.Count @(Model.Count == 1 ? "pedido" : "pedidos"))</span>
            </div>

            @if (!Model.Any())
            {
                <div class="vazio">
                    <i class="fas fa-inbox"></i>
                    Nenhum pedido encontrado.<br />
                    <a href="/Pacotes/Index" style="color:var(--azul-medio);font-weight:600;">
                        Explorar pacotes disponíveis
                    </a>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="tabela-pedidos">
                        <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Viagem</th>
                                <th>Tipo</th>
                                <th>Pagamento</th>
                                <th>Data</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                string badgeClass = p.TipoItem switch
                                {
                                    "pacote" => "badge-pacote",
                                    "destino" => "badge-destino",
                                    _ => "badge-outro"
                                };
                                string labelTipo = p.TipoItem switch
                                {
                                    "pacote" => "Pacote",
                                    "destino" => "Passagem",
                                    _ => p.TipoItem
                                };
                                <tr>
                                    <td>
                                        <div style="font-weight:800;color:var(--azul);">
                                            @(string.IsNullOrEmpty(p.CodigoReserva) ? $"#{p.Id}" : p.CodigoReserva)
                                        </div>

                                        @if (!string.IsNullOrEmpty(p.Comprovante))
                                        {
                                            <div style="font-size:.75rem;color:var(--sub);margin-top:3px;">
                                                Comprovante: @p.Comprovante
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div style="font-weight:700;color:var(--texto);line-height:1.35;">
                                            @p.NomeItem
                                        </div>

                                        <div style="font-size:.78rem;color:var(--sub);margin-top:5px;">
                                            @p.Quantidade @(p.Quantidade == 1 ? "viajante/reserva" : "viajantes/reservas")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge-tipo-item @badgeClass">@labelTipo</span>
                                    </td>

                                    <td>
                                        <div style="font-weight:800;color:var(--verde);">
                                            @(string.IsNullOrEmpty(p.StatusPagamento) ? "Confirmado" : p.StatusPagamento)
                                        </div>

                                        <div style="font-size:.78rem;color:var(--sub);margin-top:4px;">
                                            @(string.IsNullOrEmpty(p.FormaPagamento) ? "Pagamento não informado" : p.FormaPagamento)
                                            @if (p.Parcelas > 1)
                                            {
                                                <span> — @p.Parcelas x</span>
                                            }
                                        </div>
                                    </td>

                                    <td style="color:var(--sub);">
                                        @p.DataPedido.ToString("dd/MM/yyyy")
                                        <br />
                                        <span style="font-size:.78rem;">@p.DataPedido.ToString("HH:mm")</span>
                                    </td>

                                    <td class="preco-destaque">
                                        @(p.ValorTotalPedido > 0 ? p.ValorTotalPedido.ToString("C") : p.Total.ToString("C"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </main>
</div>
