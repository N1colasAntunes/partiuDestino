@{
    ViewData["Title"] = "Painel Administrativo - Partiu Destino";
}
@using MySql.Data.MySqlClient

@{
    string conexao = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
}

<style>
    /* Estilo para o Card de Métrica */
    .metric-card {
        background: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 20px;
        max-width: 350px;
        margin-bottom: 40px;
        font-family: 'Segoe UI', sans-serif;
    }

    .metric-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .icon-green {
        background-color: #f0fdf4;
        color: #22c55e;
    }

    .metric-info h4 {
        margin: 0;
        color: #64748b;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .metric-info p {
        margin: 5px 0 0 0;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e3a8a;
    }

    /* Estilo para o título */
    h2 {
        font-family: 'Segoe UI', sans-serif;
        color: #1e3a8a;
        margin-bottom: 25px;
        font-weight: 800;
    }

    /* Estilo para a tabela */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none !important;
        font-family: 'Segoe UI', sans-serif;
        margin-bottom: 30px;
    }

    th {
        background-color: #1e3a8a;
        color: #ffffff;
        text-align: left;
        padding: 15px 20px !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 15px 20px !important;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 0.95rem;
    }

    tr:hover {
        background-color: #f8fafc;
    }

    /* Destaque para o ID e Tipo */
    td:nth-child(1) {
        font-weight: bold;
        color: #64748b;
    }

    td:nth-child(4) {
        font-weight: 700;
        color: #1e3a8a;
        text-transform: capitalize;
    }

    /* Estilo para o botão Voltar */
    .sidebar-item {
        list-style: none;
        margin-top: 10px;
    }

    .sidebar-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #1e3a8a;
        font-weight: 600;
        font-family: 'Segoe UI', sans-serif;
        padding: 12px 25px;
        border: 2px solid #1e3a8a;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .sidebar-link:hover {
            background-color: #1e3a8a;
            color: #ffffff;
            transform: translateX(-5px);
        }
</style>

<!-- Usuários Registrados -->
<div class="metric-card">
    <div class="metric-icon icon-green">
        <i class="fas fa-users"></i>
    </div>

    <div class="metric-info">
        <h4>Quantidade de Usuários Registrados</h4>

        <p>
            @{
                int totalUsuarios = 0;

                using (MySqlConnection conn = new MySqlConnection(conexao))
                {
                    conn.Open();

                    string sqlUsuarios = "SELECT COUNT(*) FROM usuarios";

                    MySqlCommand cmdUsuarios = new MySqlCommand(sqlUsuarios, conn);

                    totalUsuarios = Convert.ToInt32(cmdUsuarios.ExecuteScalar());
                }
            }

            @totalUsuarios
        </p>
    </div>
</div>

<a asp-controller="Usuarios"
   asp-action="Criar"
   style="background:#16a34a;
          color:white;
          padding:10px 15px;
          text-decoration:none;
          border-radius:6px;
          display:inline-block;
          margin-bottom:20px;">
    + Novo Usuário
</a>

<h2>Usuários Cadastrados</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Tipo</th>

        <th>Ações</th>
    </tr>

    @{
        using (MySqlConnection conn = new MySqlConnection(conexao))
        {
            conn.Open();

            string sqlUsuarios = "SELECT id, nome, email, tipo FROM usuarios";

            MySqlCommand cmdUsuarios = new MySqlCommand(sqlUsuarios, conn);

            MySqlDataReader readerUsuarios = cmdUsuarios.ExecuteReader();

            while (readerUsuarios.Read())
            {
                <tr>
                    <td>@readerUsuarios["id"]</td>
                    <td>@readerUsuarios["nome"]</td>
                    <td>@readerUsuarios["email"]</td>
                    <td>@readerUsuarios["tipo"]</td>

                    <td>
                        <form asp-action="Delete" asp-controller="Usuarios" method="post"
                              onsubmit="return confirm('Tem certeza que deseja excluir este usuário?');">

                            <input type="hidden" name="id" value="@readerUsuarios["id"]" />

                            <button type="submit"
                                    style="background:#ef4444;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer;">
                                Excluir
                            </button>

                        </form>
                    </td>
                </tr>
            }
        }
    }
</table>
<li class="sidebar-item">
    <a asp-controller="Admin" asp-action="Index" class="sidebar-link">
        <i class="fas fa-arrow-left"></i>
        <span>Voltar</span>
    </a>
</li>