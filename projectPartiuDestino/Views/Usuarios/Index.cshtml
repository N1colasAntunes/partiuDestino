@{
    ViewData["Title"] = "Painel Administrativo - Partiu Destino";
}
@using MySql.Data.MySqlClient

@{
    string conexao = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
}

<style>
    /* Estilo para o Card de Métrica */
    .metric-card {
        background: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 20px;
        max-width: 350px;
        margin-bottom: 40px;
        font-family: 'Segoe UI', sans-serif;
    }

    .metric-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .icon-green {
        background-color: #f0fdf4;
        color: #22c55e;
    }

    .metric-info h4 {
        margin: 0;
        color: #64748b;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .metric-info p {
        margin: 5px 0 0 0;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e3a8a;
    }

    /* Estilo para o título */
    h2 {
        font-family: 'Segoe UI', sans-serif;
        color: #1e3a8a;
        margin-bottom: 25px;
        font-weight: 800;
    }

    /* Estilo para a tabela */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none !important;
        font-family: 'Segoe UI', sans-serif;
        margin-bottom: 30px;
    }

    th {
        background-color: #1e3a8a;
        color: #ffffff;
        text-align: left;
        padding: 15px 20px !important;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 15px 20px !important;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 0.95rem;
    }

    tr:hover {
        background-color: #f8fafc;
    }

    /* Destaque para o ID e Tipo */
    td:nth-child(1) {
        font-weight: bold;
        color: #64748b;
    }

    td:nth-child(4) {
        font-weight: 700;
        color: #1e3a8a;
        text-transform: capitalize;
    }

    /* Barra Lateral (Sidebar) */
    .admin-sidebar {
        width: 260px;
        background-color: #1e3a8a;
        color: white;
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 40px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        flex-grow: 1;
    }

    .sidebar-item {
        margin-bottom: 10px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 15px;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.3s;
        font-weight: 500;
    }

        .sidebar-link:hover, .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .sidebar-link i {
            width: 20px;
            text-align: center;
        }
</style>


<!-- Sidebar -->
<aside class="admin-sidebar">
    <div class="sidebar-header">

        <span>Administração Partiu</span>
    </div>
    <ul class="sidebar-menu">
        <li class="sidebar-item">
            <a href="/Admin/Index" class="sidebar-link active">
                <i class="fas fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/DestinosAdmin/Index" class="sidebar-link">
                <i class="fas fa-map-marked-alt"></i>
                <span>Destinos</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/PacotesAdmin/Index" class="sidebar-link">
                <i class="fas fa-suitcase-rolling"></i>
                <span>Pacotes</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="/ViagemPersonalizadaAdmin/Index" class="sidebar-link">
                <i class="fas fa-globe-americas"></i>
                <span>Viagens Personalizadas</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/Usuarios/Index" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Usuários</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="/PedidosFinalizados/Index" class="sidebar-link">
                <i class="fas fa-check-circle"></i>
                <span>Pedidos Finalizados</span>
            </a>
        </li>
    </ul>
    <div class="sidebar-footer">
        <a href="/" class="sidebar-link">
            <i class="fas fa-sign-out-alt"></i>
            <span>Sair do Painel</span>
        </a>
    </div>
</aside>

<!-- Usuários Registrados -->
<div class="metric-card">
    <div class="metric-icon icon-green">
        <i class="fas fa-users"></i>
    </div>

    <div class="metric-info">
        <h4>Quantidade de Usuários Registrados</h4>

        <p>
            @{
                int totalUsuarios = 0;

                using (MySqlConnection conn = new MySqlConnection(conexao))
                {
                    conn.Open();

                    string sqlUsuarios = "SELECT COUNT(*) FROM usuarios";

                    MySqlCommand cmdUsuarios = new MySqlCommand(sqlUsuarios, conn);

                    totalUsuarios = Convert.ToInt32(cmdUsuarios.ExecuteScalar());
                }
            }

            @totalUsuarios
        </p>
    </div>
</div>

<a asp-controller="Usuarios"
   asp-action="Criar"
   style="background:#16a34a;
          color:white;
          padding:10px 15px;
          text-decoration:none;
          border-radius:6px;
          display:inline-block;
          margin-bottom:20px;">
    + Novo Usuário
</a>

<h2>Usuários Cadastrados</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Tipo</th>

        <th>Ações</th>
    </tr>

    @{
        using (MySqlConnection conn = new MySqlConnection(conexao))
        {
            conn.Open();

            string sqlUsuarios = "SELECT id, nome, email, tipo FROM usuarios";

            MySqlCommand cmdUsuarios = new MySqlCommand(sqlUsuarios, conn);

            MySqlDataReader readerUsuarios = cmdUsuarios.ExecuteReader();

            while (readerUsuarios.Read())
            {
                <tr>
                    <td>@readerUsuarios["id"]</td>
                    <td>@readerUsuarios["nome"]</td>
                    <td>@readerUsuarios["email"]</td>
                    <td>@readerUsuarios["tipo"]</td>

                    <td style="display:flex;gap:8px;">

                        <a asp-controller="Usuarios"
                           asp-action="Editar"
                           asp-route-id="@readerUsuarios["id"]"
                           style="background:#2563eb;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;">
                            Editar
                        </a>

                        <form asp-action="Delete"
                              asp-controller="Usuarios"
                              method="post"
                              onsubmit="return confirm('Tem certeza que deseja excluir este usuário?');">

                            <input type="hidden"
                                   name="id"
                                   value="@readerUsuarios["id"]" />

                            <button type="submit"
                                    style="background:#ef4444;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer;">
                                Excluir
                            </button>

                        </form>
                    </td>
                </tr>
            }
        }
    }
</table>