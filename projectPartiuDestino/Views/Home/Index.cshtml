@model List<projectPartiuDestino.Models.Destinos>
@using MySql.Data.MySqlClient
@{
    ViewData["Title"] = "Home";

    // ── Busca pacotes em destaque direto aqui ──────────────────────────
    var pacotesDestaque = new List<projectPartiuDestino.Models.Pacotes>();
    string connStr = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";

    try
    {
        using var conn2 = new MySqlConnection(connStr);
        conn2.Open();
        string sqlPacotes = @"
            SELECT id,
                destino_id,
                nome,
                descricao,
                tipo_viagem,
                duracao_dias,
                data_partida,
                data_retorno,
                preco_por_pessoa,
                vagas_disponiveis,
                imagem_url
            FROM pacotes
            ORDER BY id DESC
            LIMIT 8";
        using var cmd2 = new MySqlCommand(sqlPacotes, conn2);
        using var reader2 = cmd2.ExecuteReader();
        while (reader2.Read())
        {
            pacotesDestaque.Add(new projectPartiuDestino.Models.Pacotes
            {
                Id = Convert.ToInt32(reader2["id"]),
                DestinoId = Convert.ToInt32(reader2["destino_id"]),
                Nome = reader2["nome"].ToString(),
                Descricao = reader2["descricao"].ToString(),
                TipoViagem = reader2["tipo_viagem"].ToString(),
                DuracaoDias = Convert.ToInt32(reader2["duracao_dias"]),
                DataPartida = Convert.ToDateTime(reader2["data_partida"]),
                DataRetorno = Convert.ToDateTime(reader2["data_retorno"]),
                PrecoPorPessoa = Convert.ToDecimal(reader2["preco_por_pessoa"]),
                VagasDisponiveis = Convert.ToInt32(reader2["vagas_disponiveis"]),
                ImagemUrl = reader2["imagem_url"]?.ToString()
            });
        }
    }
    catch { }
}

