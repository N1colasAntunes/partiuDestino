<section class="container secao-destinos">
    <h2>Conheça alguns de nossos destinos!</h2>
    <p>Veja nossos pacotes mais populares e escolha sua próxima aventura!</p>

    <div class="carrossel-container">
        <i class="fas fa-chevron-left seta-carrossel" onclick="scrollCarrossel(-1)"></i>

        <div class="carrossel-scroll" id="carrosselDestinos">
            @foreach (var destino in Model)
            {
                string imgUrl = string.IsNullOrEmpty(destino.ImagemUrl)
                ? "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=600&q=80"
                : destino.ImagemUrl + (destino.ImagemUrl.Contains("unsplash.com") && !destino.ImagemUrl.Contains("?") ? "?w=600&q=80" : "");

                string ctrl = Context.Session.GetString("UserName") != null ? "Pacotes" : "Login";

                <a asp-controller="Destinos" asp-action="Index" class="card-destino-link">
                    <div class="card-destino">
                        <img class="card-destino-img"
                             src="@imgUrl"
                             alt="@destino.Estado - @destino.Pais"
                             loading="lazy"
                             onerror="this.src='https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=600&q=80'" />
                        <div class="card-body">
                            <h4>@destino.Estado – @destino.Pais</h4>
                            <p class="info">Saindo de @destino.OrigemEstado – @destino.OrigemPais</p>
                            @if (destino.PrecoPorPessoa > 0)
                            {
                                <span class="preco-destino-label">A partir de</span>
                                <span class="preco-destino-valor">@destino.PrecoPorPessoa.ToString("C")</span>
                            }
                            <button class="btn-saiba-mais">Saiba mais</button>
                        </div>
                    </div>
                </a>
            }
        </div>

        <i class="fas fa-chevron-right seta-carrossel" onclick="scrollCarrossel(1)"></i>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════════════════════
     CARROSSEL — PACOTES EM DESTAQUE
     ══════════════════════════════════════════════════════════════════════ -->
@if (pacotesDestaque.Any())
{
    <section class="container secao-destinos" style="padding-top:20px;">
        <h2>Pacotes em Destaque</h2>
        <p>Ofertas especiais selecionadas para a sua próxima aventura.</p>

        <div class="carrossel-container">
            <i class="fas fa-chevron-left seta-carrossel" onclick="scrollCarrossel2(-1)"></i>

            <div class="carrossel-scroll" id="carrosselPacotes">
                @foreach (var p in pacotesDestaque)
                {
                    string imgUrl = string.IsNullOrEmpty(p.ImagemUrl)
                    ? "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=600&q=80"
                    : p.ImagemUrl + (p.ImagemUrl.Contains("unsplash.com") && !p.ImagemUrl.Contains("?")
                    ? "?w=600&q=80"
                    : "");

                    string vagasCss = p.VagasDisponiveis > 5 ? "vagas-ok"
                    : p.VagasDisponiveis > 0 ? "vagas-alerta"
                    : "vagas-esgotado";

                    string vagasTxt = p.VagasDisponiveis > 5 ? $"{p.VagasDisponiveis} vagas"
                    : p.VagasDisponiveis > 0 ? $"Últimas {p.VagasDisponiveis}!"
                    : "Esgotado";

                    bool esgotado = p.VagasDisponiveis == 0;

                    <div class="card-pacote">
                        <img class="card-pacote-img"
                             src="@imgUrl"
                             alt="@p.Nome"
                             loading="lazy"
                             onerror="this.src='https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=600&q=80'" />

                        <div class="card-pacote-body">
                            <h4>@p.Nome</h4>
                            <div class="pacote-mini-info">
                                <span class="pacote-mini-tag"><i class="fas fa-clock"></i> @p.DuracaoDias dias</span>
                                <span class="pacote-mini-tag"><i class="fas fa-calendar"></i> @p.DataPartida.ToString("dd/MM/yy")</span>
                            </div>
                            <p>@(p.Descricao?.Length > 75 ? p.Descricao.Substring(0, 75) + "…" : p.Descricao)</p>
                            <div class="pacote-footer-row">
                                <div>
                                    <div class="pacote-preco-label">Por pessoa</div>
                                    <div class="pacote-preco-valor">@p.PrecoPorPessoa.ToString("C")</div>
                                </div>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    <a asp-controller="Pacotes" asp-action="Detalhes" asp-route-id="@p.Id" class="btn-detalhes-home">
                                       Detalhes
                                    </a>
                                    @if (Context.Session.GetString("UserName") != null)
                                    {
                                        if (!esgotado)
                                        {
                                            <form asp-controller="Carrinho" asp-action="AdicionarPacote"
                                                  method="post" style="margin:0;">
                                                <input type="hidden" name="pacoteId" value="@p.Id" />
                                                <button type="submit" class="btn-reservar">
                                                    <i class="fas fa-cart-plus"></i> Reservar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="btn-reservar esgotado">Esgotado</span>
                                        }
                                    }
                                    else
                                    {
                                        <a asp-controller="Login" asp-action="Index" class="btn-reservar">
                                            <i class="fas fa-sign-in-alt"></i> Entrar
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <i class="fas fa-chevron-right seta-carrossel" onclick="scrollCarrossel2(1)"></i>
        </div>
    </section>
}


