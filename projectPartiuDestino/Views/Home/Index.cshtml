<script>
    function scrollCarrossel(direcao) {
        const carrossel = document.getElementById('carrosselDestinos');
        carrossel.scrollBy({ left: direcao * 320, behavior: 'smooth' });
    }

    function toggleFaq(btn) {
        const resposta = btn.nextElementSibling;
        const aberta = resposta.classList.contains('aberta');
        document.querySelectorAll('.faq-resposta.aberta').forEach(r => r.classList.remove('aberta'));
        document.querySelectorAll('.faq-pergunta').forEach(b => b.setAttribute('aria-expanded', 'false'));
        if (!aberta) {
            resposta.classList.add('aberta');
            btn.setAttribute('aria-expanded', 'true');
        }
    }
</script>