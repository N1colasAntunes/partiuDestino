<!-- ══════════════════════════════════════════════════════════════════════
     HERO COM VÍDEO
     ══════════════════════════════════════════════════════════════════════ -->
<section class="hero-container">
    <video class="hero-video-bg" autoplay muted loop playsinline>
        <source src="~/images/14424420_1920_1080_30fps.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>Seu destino começa aqui</h1>
        <p>Viaje do seu jeito, com roteiros exclusivos e personalizados. Reserve agora.</p>
        @if (Context.Session.GetString("UserName") != null)
        {
            <a asp-controller="Personalizada" asp-action="Index" class="btn-monte-viagem">Monte sua viagem</a>
        }
        else
        {
            <a asp-controller="Login" asp-action="Index" class="btn-monte-viagem">Monte sua viagem</a>
        }
    </div>
</section>


@* BARRA DE PESQUISA  *@
<form method="get" asp-controller="Destinos" asp-action="Index">
    <section class="container mt-5 mb-5">
        <div class="barra-busca-home">
            <div class="row g-3">

                <div class="col-md-2">
                    <label class="form-label">Origem</label>
                    <select class="form-select" name="origem">
                        <option selected>Selecione</option>

                        @foreach (string origem in ViewBag.Origens)
                        {
                            <option>@origem</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Destino</label>
                    <select class="form-select" name="destino">
                        <option selected>Selecione</option>

                        @foreach (string destino in ViewBag.Destinos)
                        {
                            <option>@destino</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Entrada</label>
                    <input type="date" class="form-control">
                </div>

                <div class="col-md-2">
                    <label class="form-label">Saída</label>
                    <input type="date" class="form-control">
                </div>

                <div class="col-md-2">
                    <label class="form-label">Pessoas</label>
                    <select class="form-select">
                        <option>1 Pessoa</option>
                        <option>2 Pessoas</option>
                        <option>3 Pessoas</option>
                        <option>4 Pessoas</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn-buscar-home w-100">
                        Buscar
                    </button>
                </div>
            </div>
        </div>
    </section>
</form>

