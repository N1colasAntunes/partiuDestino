<script>
    function scrollCarrossel(d)  { document.getElementById('carrosselDestinos').scrollBy({ left: d * 320, behavior: 'smooth' }); }
    function scrollCarrossel2(d) { document.getElementById('carrosselPacotes').scrollBy({ left: d * 320, behavior: 'smooth' }); }

    function toggleFaq(btn) {
        const r = btn.nextElementSibling;
        const aberta = r.classList.contains('aberta');
        document.querySelectorAll('.faq-resposta.aberta').forEach(x => x.classList.remove('aberta'));
        document.querySelectorAll('.faq-pergunta').forEach(b => b.setAttribute('aria-expanded','false'));
        if (!aberta) { r.classList.add('aberta'); btn.setAttribute('aria-expanded','true'); }
    }


    // botao do topo
    
</script>