@model projectPartiuDestino.Models.Destinos
@{
    ViewData["Title"] = $"Passagem - {Model.Pais} - {Model.Estado}";
    var assentosOcupados = ViewBag.AssentosOcupados as List<string> ?? new List<string>();
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --text-muted: #6b7280;
        --border: #e5e7eb;
        --occupied: #d1d5db;
        --selected: #3b82f6;
        --available: #ffffff;
    }

    .voo-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 50px 0 80px;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .voo-hero {
        background: linear-gradient(135deg,var(--primary),var(--accent));
        padding: 50px 0 70px;
        color: white;
        text-align: center;
    }

        .voo-hero h1 {
            font-size: 2.2rem;
            font-weight: 900;
            margin-bottom: 6px;
        }

        .voo-hero p {
            opacity: .9;
        }

    .voo-resumo {
        max-width: 800px;
        margin: -40px auto 40px;
        background: white;
        border-radius: 18px;
        padding: 24px 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .resumo-rota {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
        color: #1f2937;
    }

        .resumo-rota i {
            color: var(--accent);
        }

    .voo-layout {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .card-secao-voo {
        background: white;
        border-radius: 18px;
        padding: 32px;
        margin-bottom: 24px;
        border: 1px solid var(--border);
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

        .card-secao-voo h3 {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 18px;
            color: #1f2937;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .opcoes-classe {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .opcao-classe input {
        display: none;
    }

    .opcao-classe-label {
        display: block;
        border: 2px solid var(--border);
        border-radius: 14px;
        padding: 18px;
        text-align: center;
        cursor: pointer;
        transition: .2s;
    }

        .opcao-classe-label .nome-classe {
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 6px;
            display: block;
        }

        .opcao-classe-label .preco-classe {
            font-size: .85rem;
            color: var(--success);
            font-weight: 700;
        }

    .opcao-classe input:checked + .opcao-classe-label {
        border-color: var(--primary);
        background: #eff6ff;
    }

    .airplane-map {
        background: #f1f5f9;
        border-radius: 50px 50px 20px 20px;
        padding: 40px 20px;
        max-width: 500px;
        margin: 0 auto;
        border: 2px solid #e2e8f0;
    }

    .airplane-header {
        text-align: center;
        margin-bottom: 30px;
        color: var(--text-muted);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .seat-grid {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        gap: 10px;
        align-items: center;
    }

    .seat-row-num {
        grid-column: 4;
        text-align: center;
        font-size: .8rem;
        color: var(--text-muted);
        font-weight: 700;
    }

    .seat {
        width: 35px;
        height: 35px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: .7rem;
        font-weight: 700;
        transition: all .2s;
        background: var(--available);
    }

        .seat:hover:not(.occupied) {
            border-color: var(--accent);
            background: #f0f9ff;
        }

        .seat.occupied {
            background: var(--occupied);
            cursor: not-allowed;
            color: #9ca3af;
            border-color: #d1d5db;
            position: relative;
        }

            .seat.occupied::after {
                content: 'X';
                position: absolute;
                font-size: 1rem;
                color: #6b7280;
            }

        .seat.selected {
            background: var(--selected);
            border-color: var(--primary);
            color: white;
        }

    .seat-legend {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
        font-size: .85rem;
        font-weight: 600;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .legend-box {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
    }

    .btn-continuar-voo {
        width: 100%;
        background: linear-gradient(135deg,var(--primary),#1e40af);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 14px;
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: .2s;
        margin-top: 20px;
    }

        .btn-continuar-voo:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(30,58,138,.25);
        }

    @@media (max-width:700px) {
        .opcoes-classe {
            grid-template-columns: 1fr;
        }
    }

    .voo-resumo-completo {
        max-width: 980px;
        margin: -40px auto 40px;
        background: #ffffff;
        border-radius: 18px;
        padding: 24px 30px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .10);
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 28px;
        flex-wrap: wrap;
    }

    .resumo-info-principal {
        flex: 1;
        min-width: 340px;
    }

    .resumo-rota-cidade {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        color: #1e3a8a;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: .9rem;
        font-weight: 900;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

        .resumo-rota-cidade i {
            color: var(--accent);
        }

        .resumo-rota-cidade strong {
            color: #0f172a;
            font-weight: 900;
        }

    .resumo-companhia {
        margin-bottom: 14px;
    }

        .resumo-companhia span,
        .resumo-rota-linha span,
        .resumo-dados-voo strong {
            display: block;
            font-size: .68rem;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 900;
            margin-bottom: 4px;
            letter-spacing: .02em;
        }

        .resumo-companhia strong {
            color: #0f172a;
            font-size: 1rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .resumo-companhia i {
            color: var(--accent);
        }

    .resumo-rota-linha {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }

        .resumo-rota-linha div {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 10px 14px;
            min-width: 165px;
        }

        .resumo-rota-linha strong {
            color: #1f2937;
            font-size: .9rem;
            font-weight: 900;
        }

        .resumo-rota-linha i {
            color: var(--accent);
        }

    .resumo-dados-voo {
        display: grid;
        grid-template-columns: repeat(3, minmax(100px, auto));
        gap: 12px;
        align-items: stretch;
    }

        .resumo-dados-voo div {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 10px 14px;
            min-width: 105px;
        }

        .resumo-dados-voo span {
            display: block;
            color: #334155;
            font-weight: 800;
            font-size: .88rem;
        }

    .resumo-preco-completo {
        background: #ecfdf5 !important;
        border-color: #bbf7d0 !important;
    }

        .resumo-preco-completo span {
            color: #047857;
            font-size: 1rem;
            font-weight: 900;
        }

    @@media (max-width: 900px) {
        .voo-resumo-completo {
            padding: 22px;
        }

        .resumo-dados-voo {
            grid-template-columns: repeat(2, 1fr);
            width: 100%;
        }

            .resumo-dados-voo div {
                min-width: unset;
            }
    }

    @@media (max-width: 600px) {
        .resumo-rota-cidade {
            border-radius: 16px;
            line-height: 1.5;
            align-items: flex-start;
        }

        .resumo-rota-linha {
            flex-direction: column;
            align-items: stretch;
        }

            .resumo-rota-linha i {
                transform: rotate(90deg);
                align-self: center;
            }

        .resumo-dados-voo {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="voo-page">
    <div class="voo-hero">
        <h1>Escolha sua Passagem</h1>
        <p>Etapa 1 — Destino selecionado: @Model.Pais - @Model.Estado</p>
    </div>

    @{
        string origemEstado = Model.OrigemEstado ?? "São Paulo";
        string origemPais = Model.OrigemPais ?? "Brasil";

        string destinoEstado = Model.Estado ?? "Destino";
        string destinoPais = Model.Pais ?? "Brasil";

        string companhiaAerea = "Azul Linhas Aéreas";
        string tituloVoo = "Voo nacional direto";

        string aeroportoOrigem = origemEstado == "São Paulo"
        ? "CGH - Congonhas"
        : origemEstado + " - Aeroporto principal";

        string aeroportoDestino = destinoEstado == "Rio de Janeiro"
        ? "SDU - Santos Dumont"
        : destinoEstado + " - Aeroporto principal";

        DateTime dataIda = DateTime.Today.AddDays(30);
        DateTime dataVolta = DateTime.Today.AddDays(37);

        string horarioIda = "08:30";
        string horarioVolta = "18:45";
        string duracaoMedia = "1h 10min";
    }

    <div class="voo-resumo voo-resumo-completo">

        <div class="resumo-info-principal">

            <div class="resumo-rota-cidade">
                <i class="fas fa-map-marker-alt"></i>

                <strong>
                    @origemEstado - @origemPais
                </strong>

                <i class="fas fa-arrow-right"></i>

                <strong>
                    @destinoEstado - @destinoPais
                </strong>
            </div>

            <div class="resumo-companhia">
                <span>Companhia aérea</span>
                <strong>
                    <i class="fas fa-plane-departure"></i>
                    @companhiaAerea
                </strong>
            </div>

            <div class="resumo-rota-linha">
                <div>
                    <span>Origem</span>
                    <strong>@aeroportoOrigem</strong>
                </div>

                <i class="fas fa-arrow-right"></i>

                <div>
                    <span>Destino</span>
                    <strong>@aeroportoDestino</strong>
                </div>
            </div>
        </div>

        <div class="resumo-dados-voo">

            <div>
                <strong>Data ida</strong>
                <span>@dataIda.ToString("dd/MM/yyyy")</span>
            </div>

            <div>
                <strong>Horário ida</strong>
                <span>@horarioIda</span>
            </div>

            <div>
                <strong>Data volta</strong>
                <span>@dataVolta.ToString("dd/MM/yyyy")</span>
            </div>

            <div>
                <strong>Horário volta</strong>
                <span>@horarioVolta</span>
            </div>

            <div>
                <strong>Duração</strong>
                <span>@duracaoMedia</span>
            </div>

            <div class="resumo-preco-completo">
                <strong>Preço por pessoa</strong>
                <span>R$ 1.200,00</span>
            </div>

        </div>
    </div>

    <div class="voo-layout">

        @if (TempData["Erro"] != null)
        {
            <div style="background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;padding:14px 20px;border-radius:12px;margin-bottom:20px;font-weight:600;">
                <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
            </div>
        }

        <form method="post" asp-action="Passagem" id="formVoo">
            <input type="hidden" name="destinoId" value="@Model.Id" />
            <input type="hidden" name="numeroAssento" id="inputAssento" value="" />

            <div class="card-secao-voo">
                <h3><i class="fas fa-users" style="color:var(--accent);"></i> Quantidade de viajantes</h3>
                <p style="color:var(--text-muted);margin-top:-8px;margin-bottom:20px;">
                    Informe quantas pessoas vão viajar. A quantidade de assentos deve ser igual ao total de viajantes.
                </p>
                <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;">
                    <div>
                        <label style="font-weight:700;color:#1f2937;margin-bottom:6px;display:block;">Adultos</label>
                        <input type="number" name="quantidadeAdultos" id="quantidadeAdultos" value="1" min="1" max="10"
                               onchange="atualizarQuantidadeViajantes()" onkeyup="atualizarQuantidadeViajantes()"
                               style="width:100%;padding:13px;border:1px solid var(--border);border-radius:12px;font-weight:700;" />
                    </div>
                    <div>
                        <label style="font-weight:700;color:#1f2937;margin-bottom:6px;display:block;">Crianças</label>
                        <input type="number" name="quantidadeCriancas" id="quantidadeCriancas" value="0" min="0" max="10"
                               onchange="atualizarQuantidadeViajantes()" onkeyup="atualizarQuantidadeViajantes()"
                               style="width:100%;padding:13px;border:1px solid var(--border);border-radius:12px;font-weight:700;" />
                    </div>
                </div>
                <div style="margin-top:18px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a;border-radius:14px;padding:14px 18px;font-weight:800;">
                    Total de viajantes: <span id="totalViajantes">1</span>
                    <span style="font-weight:600;color:#475569;"> — selecione essa mesma quantidade de assentos.</span>
                </div>
            </div>

            <div class="card-secao-voo">
                <h3><i class="fas fa-plane-departure" style="color:var(--accent);"></i> Classe da passagem</h3>
                <div class="opcoes-classe">
                    <label class="opcao-classe">
                        <input type="radio" name="classeViagem" value="Econômica" checked />
                        <span class="opcao-classe-label">
                            <span class="nome-classe">Econômica</span>
                            <span class="preco-classe">Sem adicional</span>
                        </span>
                    </label>
                    <label class="opcao-classe">
                        <input type="radio" name="classeViagem" value="Executiva" />
                        <span class="opcao-classe-label">
                            <span class="nome-classe">Executiva</span>
                            <span class="preco-classe">+ R$ 450,00 por pessoa</span>
                        </span>
                    </label>
                    <label class="opcao-classe">
                        <input type="radio" name="classeViagem" value="Primeira Classe" />
                        <span class="opcao-classe-label">
                            <span class="nome-classe">Primeira Classe</span>
                            <span class="preco-classe">+ R$ 1.200,00 por pessoa</span>
                        </span>
                    </label>
                </div>
            </div>

            <h3>Selecione os Assentos</h3>
            <p style="color:var(--text-muted);margin-top:-8px;margin-bottom:20px;">
                Clique nos assentos disponíveis. A quantidade precisa bater com o total de viajantes.
            </p>

            <div class="airplane-map">
                <div class="airplane-header">Cabine de Passageiros</div>
                <div class="seat-grid">
                    <div style="text-align:center;font-weight:bold;">A</div>
                    <div style="text-align:center;font-weight:bold;">B</div>
                    <div style="text-align:center;font-weight:bold;">C</div>
                    <div></div>
                    <div style="text-align:center;font-weight:bold;">D</div>
                    <div style="text-align:center;font-weight:bold;">E</div>
                    <div style="text-align:center;font-weight:bold;">F</div>

                    @for (int i = 1; i <= 10; i++)
                    {
                        string[] cols = { "A", "B", "C", "D", "E", "F" };
                        foreach (var col in cols)
                        {
                            string seatId = $"{i}{col}";
                            bool isOccupied = assentosOcupados.Contains(seatId);
                            string seatType = (col == "A" || col == "F") ? "Janela" : (col == "C" || col == "D" ? "Corredor" : "Meio");

                            <div class="seat @(isOccupied ? "occupied" : "")" data-seat="@seatId" data-type="@seatType" onclick="selectSeat(this)">
                                @seatId
                            </div>

                            if (col == "C")
                            {
                                <div class="seat-row-num">@i</div>
                            }
                        }
                    }
                </div>
                <div class="seat-legend">
                    <div class="legend-item"><div class="legend-box" style="background:var(--available);"></div> Disponível</div>
                    <div class="legend-item"><div class="legend-box" style="background:var(--occupied);"></div> Ocupado</div>
                    <div class="legend-item"><div class="legend-box" style="background:var(--selected);"></div> Selecionado</div>
                </div>
            </div>

            <div id="seat-info" style="margin-top:20px; text-align:center; font-weight:700; color:var(--primary); display:none;">
                Assentos selecionados: <span id="selected-seat-display">--</span>
                <br />
                <span style="font-size:.85rem;color:#64748b;">
                    Selecionados: <span id="qtdAssentosSelecionados">0</span> de <span id="qtdAssentosNecessarios">1</span>
                </span>
            </div>

            <button type="submit" class="btn-continuar-voo">
                Continuar <i class="fas fa-arrow-right"></i>
            </button>
        </form>
    </div>
</div>

<script>
    let assentosSelecionados = [];

    function getTotalViajantes() {
        const adultos = parseInt(document.getElementById('quantidadeAdultos').value) || 0;
        const criancas = parseInt(document.getElementById('quantidadeCriancas').value) || 0;
        return adultos + criancas;
    }

    function atualizarQuantidadeViajantes() {
        const total = getTotalViajantes();
        document.getElementById('totalViajantes').innerText = total;
        document.getElementById('qtdAssentosNecessarios').innerText = total;

        if (assentosSelecionados.length > total) {
            assentosSelecionados = assentosSelecionados.slice(0, total);
            document.querySelectorAll('.seat.selected').forEach(s => {
                const seatId = s.getAttribute('data-seat');
                if (!assentosSelecionados.includes(seatId)) s.classList.remove('selected');
            });
        }
        atualizarAssentosNaTela();
    }

    function selectSeat(element) {
        if (element.classList.contains('occupied')) return;
        const totalNecessario = getTotalViajantes();
        const seatId = element.getAttribute('data-seat');

        if (totalNecessario <= 0) { alert('Informe a quantidade de viajantes antes de escolher os assentos.'); return; }

        if (element.classList.contains('selected')) {
            element.classList.remove('selected');
            assentosSelecionados = assentosSelecionados.filter(a => a !== seatId);
            atualizarAssentosNaTela();
            return;
        }

        if (assentosSelecionados.length >= totalNecessario) {
            alert('Você já selecionou a quantidade necessária de assentos.');
            return;
        }

        element.classList.add('selected');
        assentosSelecionados.push(seatId);
        atualizarAssentosNaTela();
    }

    function atualizarAssentosNaTela() {
        const textoAssentos = assentosSelecionados.join(', ');
        document.getElementById('inputAssento').value = textoAssentos;
        document.getElementById('qtdAssentosSelecionados').innerText = assentosSelecionados.length;

        if (assentosSelecionados.length > 0) {
            document.getElementById('seat-info').style.display = 'block';
            document.getElementById('selected-seat-display').innerText = textoAssentos;
        } else {
            document.getElementById('seat-info').style.display = 'none';
            document.getElementById('selected-seat-display').innerText = '--';
        }
    }

    document.getElementById('formVoo').onsubmit = function () {
        const totalViajantes = getTotalViajantes();
        if (totalViajantes <= 0) { alert('Informe a quantidade de viajantes.'); return false; }
        if (assentosSelecionados.length !== totalViajantes) {
            alert('Você precisa escolher exatamente ' + totalViajantes + ' assento(s).');
            return false;
        }
        return true;
    };

    atualizarQuantidadeViajantes();
</script>