@model IEnumerable<projectPartiuDestino.Models.Destinos>

@{
    ViewData["Title"] = "Destinos - Partiu Destino";
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --danger: #ef4444;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .destinos-container {
        background-color: var(--bg-body);
        padding: 60px 0;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .header-secao {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-secao h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .header-secao p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 650px;
            margin: 0 auto;
        }

    .destinos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 30px;
    }

    /* ── Card ── */
    .card-destino-premium {
        background: var(--white);
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 4px 6px rgba(0,0,0,.05);
        transition: transform .3s, box-shadow .3s;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .card-destino-premium:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px rgba(0,0,0,.10);
        }

    /* ── Topo com imagem ── */
    .destino-topo {
        height: 200px;
        position: relative;
        overflow: hidden;
    }

    .destino-topo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .4s ease;
    }

    .card-destino-premium:hover .destino-topo-img {
        transform: scale(1.06);
    }

    .destino-topo-fallback {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .destino-topo-fallback i {
            font-size: 3.5rem;
            color: rgba(255,255,255,.25);
        }

    .destino-topo-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,.18) 0%, rgba(0,0,0,0) 60%);
    }

    .badge-internacional,
    .badge-nacional {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
        color: white;
        z-index: 2;
        backdrop-filter: blur(4px);
    }

    .badge-internacional {
        background: rgba(239,68,68,.85);
    }

    .badge-nacional {
        background: rgba(16,185,129,.85);
    }

    /* ── Conteúdo ── */
    .destino-conteudo {
        padding: 22px 25px;
        flex-grow: 1;
    }

    .rota-tag {
        font-size: .72rem;
        font-weight: 800;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
    }

    .destino-titulo {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 16px;
    }

    .rota-box {
        background: #f9fafb;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 16px;
    }

    .rota-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .rota-local {
        display: flex;
        flex-direction: column;
    }

    .rota-label {
        font-size: .68rem;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 700;
        margin-bottom: 3px;
    }

    .rota-valor {
        font-size: .9rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .rota-seta {
        font-size: 1.2rem;
        color: var(--accent);
        margin: 0 14px;
    }

    .descricao-destino {
        font-size: .88rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

    /* ── Footer do card com preço ── */
    .destino-footer {
        padding: 16px 25px;
        border-top: 1px solid var(--border);
        background: #fcfcfd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .destino-preco-box {
        display: flex;
        flex-direction: column;
    }

    .destino-preco-label {
        font-size: .65rem;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
    }

    .destino-preco-valor {
        font-size: 1.25rem;
        font-weight: 900;
        color: var(--primary);
    }

    .btn-adicionar-destino {
        background: var(--primary);
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 12px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        font-size: .88rem;
        transition: background .25s, transform .2s;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-adicionar-destino:hover {
            background: var(--accent);
            color: white;
            transform: scale(1.04);
        }

    .lista-vazia {
        grid-column: 1 / -1;
        text-align: center;
        padding: 100px 20px;
        background: white;
        border-radius: 20px;
        border: 2px dashed var(--border);
    }

    @@media (max-width: 768px) {
        .destinos-grid {
            grid-template-columns: 1fr;
        }

        .rota-item {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }

        .rota-seta {
            transform: rotate(90deg);
        }
    }

    .search-container {
        position: relative;
        max-width: 500px;
        margin: 30px auto;
    }

        .search-container input {
            width: 100%;
            padding: 14px 20px;
            padding-right: 50px;
            border: none;
            border-radius: 50px;
            background: white;
            box-shadow: 0 5px 15px rgba(0,0,0,.1);
            font-size: 16px;
            outline: none;
            transition: .3s;
        }

            .search-container input:focus {
                box-shadow: 0 5px 20px rgba(59,130,246,.3);
            }

        .search-container i {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #3b82f6;
        }
</style>

<div class="destinos-container">
    <div class="container">
        <div class="search-container">
            <input type="text"
                   id="pesquisaDestino"
                   placeholder="Pesquisar destinos...">

            <i class="fas fa-search"></i>
        </div>

        <div id="resultadoPesquisa">
            <!-- Destinos aparecerão aqui -->
        </div>

        <div class="header-secao">
            <h1>Destinos Disponíveis</h1>
            <p>Explore destinos nacionais e internacionais saindo de diferentes regiões do Brasil.</p>
        </div>

        <div class="destinos-grid">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    bool intl = item.OrigemPais != item.Pais;
                    string imgUrl = string.IsNullOrEmpty(item.ImagemUrl) ? "" :
                    item.ImagemUrl + (item.ImagemUrl.Contains("unsplash.com") && !item.ImagemUrl.Contains("?") ? "?w=700&q=80" : "");

                    <div class="card-destino-premium">

                        <!-- Topo com imagem real -->
                        <div class="destino-topo">
                            @if (!string.IsNullOrEmpty(imgUrl))
                            {
                                <img class="destino-topo-img"
                                     src="@imgUrl"
                                     alt="@item.Estado, @item.Pais"
                                     loading="lazy"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="destino-topo-fallback" style="display:none;">
                                    <i class="fas fa-earth-americas"></i>
                                </div>
                            }
                            else
                            {
                                <div class="destino-topo-fallback">
                                    <i class="fas fa-earth-americas"></i>
                                </div>
                            }
                            <div class="destino-topo-overlay"></div>
                            @if (intl)
                            {
                                <span class="badge-internacional">Internacional</span>
                            }
                            else
                            {

                                <span class="badge-nacional">Nacional</span>
                            }
                        </div>

                        <!-- Conteúdo -->
                        <div class="destino-conteudo">
                            <span class="rota-tag">Rota de Viagem</span>
                            <h3 class="destino-titulo">@item.Pais – @item.Estado</h3>

                            <div class="rota-box">
                                <div class="rota-item">
                                    <div class="rota-local">
                                        <span class="rota-label">Origem</span>
                                        <span class="rota-valor">@item.OrigemPais – @item.OrigemEstado</span>
                                    </div>
                                    <div class="rota-seta"><i class="fas fa-arrow-right"></i></div>
                                    <div class="rota-local">
                                        <span class="rota-label">Destino</span>
                                        <span class="rota-valor">@item.Pais – @item.Estado</span>
                                    </div>
                                </div>
                            </div>

                            <p class="descricao-destino">
                                Descubra experiências incríveis em @item.Estado, @item.Pais,
                                com roteiros cuidadosamente planejados para sua próxima aventura.
                            </p>
                        </div>

                        <!-- Footer com preço + botão -->
                        <div class="destino-footer">
                            <div class="destino-preco-box">
                                <span class="destino-preco-label">A partir de</span>
                                <span class="destino-preco-valor">@item.PrecoPorPessoa.ToString("C")</span>
                            </div>

                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <form asp-controller="Carrinho" asp-action="AdicionarDestino"
                                      method="post" style="margin:0;">
                                    <input type="hidden" name="destinoId" value="@item.Id" />
                                    <button type="submit" class="btn-adicionar-destino">
                                        <i class="fas fa-cart-plus"></i> Adicionar ao Carrinho
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Login" asp-action="Index" class="btn-adicionar-destino">
                                    <i class="fas fa-sign-in-alt"></i> Entre para Reservar
                                </a>
                            }
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="lista-vazia">
                    <i class="fas fa-map-location-dot fa-4x mb-4" style="color:#cbd5e1;"></i>
                    <h3>Nenhum destino encontrado</h3>
                    <p>Estamos adicionando novos destinos incríveis. Volte em breve!</p>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-primary mt-3 px-4 py-2 rounded-pill">Voltar ao Início</a>
                </div>
            }

        </div>
    </div>
</div>
<script>
    const pesquisa = document.getElementById("pesquisaDestino");

    pesquisa.addEventListener("keyup", function () {

        let termo = this.value.trim();

        if (termo.length < 2) {
            document.getElementById("resultadoPesquisa").innerHTML = "";
            return;
        }

        fetch('/Destinos/Buscar?termo=' + encodeURIComponent(termo))
            .then(response => response.text())
            .then(html => {
                document.getElementById("resultadoPesquisa").innerHTML = html;
            });

    });
</script>