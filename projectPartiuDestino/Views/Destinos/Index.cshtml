@model IEnumerable<projectPartiuDestino.Models.Destinos>

@{
    ViewData["Title"] = "Destinos - Partiu Destino";
}

<style>
    /* ============================================
           ESTILO PÁGINA DE DESTINOS PREMIUM
           ============================================ */

    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .destinos-container {
        background-color: var(--bg-body);
        padding: 60px 0;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .header-secao {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-secao h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .header-secao p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 650px;
            margin: 0 auto;
        }

    /* Grid */
    .destinos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 30px;
    }

    /* Card */
    .card-destino-premium {
        background: var(--white);
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .card-destino-premium:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px rgba(0,0,0,0.10);
        }

    /* Topo */
    .destino-topo {
        height: 180px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .destino-topo i {
            font-size: 4rem;
            color: rgba(255,255,255,0.25);
        }

    .badge-internacional,
    .badge-nacional {
        position: absolute;
        top: 18px;
        right: 18px;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
    }

    .badge-internacional {
        background: var(--danger);
    }

    .badge-nacional {
        background: var(--success);
    }

    /* Conteúdo */
    .destino-conteudo {
        padding: 25px;
        flex-grow: 1;
    }

    .rota-tag {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: block;
    }

    .destino-titulo {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 20px;
    }

    /* Blocos */
    .rota-box {
        background: #f9fafb;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .rota-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .rota-local {
        display: flex;
        flex-direction: column;
    }

    .rota-label {
        font-size: 0.70rem;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 700;
        margin-bottom: 3px;
    }

    .rota-valor {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .rota-seta {
        font-size: 1.4rem;
        color: var(--accent);
        margin: 0 15px;
    }

    .descricao-destino {
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

    /* Footer */
    .destino-footer {
        padding: 20px 25px;
        border-top: 1px solid var(--border);
        background: #fcfcfd;
        display: flex;
        justify-content: flex-end;
    }

    .btn-detalhes-destino {
        background: var(--primary);
        color: white;
        text-decoration: none;
        padding: 10px 22px;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s;
    }

        .btn-detalhes-destino:hover {
            background: var(--accent);
            color: white;
            transform: scale(1.05);
        }

    /* Lista vazia */
    .lista-vazia {
        grid-column: 1 / -1;
        text-align: center;
        padding: 100px 20px;
        background: white;
        border-radius: 20px;
        border: 2px dashed var(--border);
    }

    @@media (max-width: 768px) {
        .destinos-grid {
            grid-template-columns: 1fr;
        }

        .rota-item {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .rota-seta {
            transform: rotate(90deg);
        }
    }
</style>

<div class="destinos-container">
    <div class="container">

        <div class="header-secao">
            <h1>Destinos Disponíveis</h1>
            <p>
                Explore destinos nacionais e internacionais saindo de diferentes regiões do Brasil.
            </p>
        </div>

        <div class="destinos-grid">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    bool internacional = item.OrigemPais != item.Pais;

                    <div class="card-destino-premium">

                        <div class="destino-topo">

                            @if (internacional)
                            {
                                <span class="badge-internacional">
                                    Internacional
                                </span>
                            }
                            else
                            {
                                <span class="badge-nacional">
                                    Nacional
                                </span>
                            }

                            <i class="fas fa-earth-americas"></i>
                        </div>

                        <div class="destino-conteudo">

                            <span class="rota-tag">
                                Rota de Viagem
                            </span>

                            <h3 class="destino-titulo">
                                @item.Pais - @item.Estado
                            </h3>

                            <div class="rota-box">
                                <div class="rota-item">

                                    <div class="rota-local">
                                        <span class="rota-label">
                                            Origem
                                        </span>

                                        <span class="rota-valor">
                                            @item.OrigemPais - @item.OrigemEstado
                                        </span>
                                    </div>

                                    <div class="rota-seta">
                                        <i class="fas fa-arrow-right"></i>
                                    </div>

                                    <div class="rota-local">
                                        <span class="rota-label">
                                            Destino
                                        </span>

                                        <span class="rota-valor">
                                            @item.Pais - @item.Estado
                                        </span>
                                    </div>

                                </div>
                            </div>

                            <p class="descricao-destino">
                                Descubra experiências incríveis em @item.Estado, @item.Pais,
                                com roteiros cuidadosamente planejados para sua próxima aventura.
                            </p>

                        </div>

                        <div class="destino-footer">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn-detalhes-destino">
                                Ver Destino
                            </a>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="lista-vazia">
                    <i class="fas fa-map-location-dot fa-4x mb-4" style="color: #cbd5e1;"></i>

                    <h3>Nenhum destino encontrado</h3>

                    <p>
                        Estamos adicionando novos destinos incríveis.
                        Volte em breve!
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary mt-3 px-4 py-2 rounded-pill">
                        Voltar ao Início
                    </a>
                </div>
            }

        </div>
    </div>
</div>