@model projectPartiuDestino.Models.Destinos
@{
    ViewData["Title"] = "Detalhes do Destino - Partiu Destino";
    var pacotes = ViewBag.PacotesDestino as List<projectPartiuDestino.Models.Pacotes>;
    bool internacional = Model.OrigemPais != Model.Pais;
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .det-page {
        background: var(--bg-body);
        min-height: 100vh;
        padding-bottom: 80px;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    /* Hero do destino */
    .det-hero {
        background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        padding: 70px 0 90px;
        color: white;
        text-align: center;
        position: relative;
    }

    .det-hero-badge {
        display: inline-block;
        padding: 5px 16px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .badge-intl {
        background: rgba(239,68,68,0.85);
    }

    .badge-nac {
        background: rgba(16,185,129,0.85);
    }

    .det-hero h1 {
        font-size: 2.8rem;
        font-weight: 900;
        margin-bottom: 12px;
    }

    .det-hero-sub {
        font-size: 1.1rem;
        opacity: 0.85;
    }

    /* Card flutuante de rota */
    .rota-card {
        max-width: 600px;
        margin: -45px auto 50px;
        background: white;
        border-radius: 18px;
        padding: 28px 35px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.12);
        display: flex;
        align-items: center;
        justify-content: space-around;
        gap: 20px;
    }

    .rota-ponto {
        text-align: center;
    }

        .rota-ponto .rp-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .rota-ponto .rp-pais {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .rota-ponto .rp-estado {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

    .rota-seta-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

        .rota-seta-box i {
            font-size: 1.6rem;
            color: var(--accent);
        }

        .rota-seta-box span {
            font-size: 0.7rem;
            color: var(--text-muted);
            font-weight: 600;
        }

    /* Info cards */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 18px;
        margin-bottom: 50px;
    }

    .info-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .info-card-icone {
        width: 48px;
        height: 48px;
        background: #eff6ff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: var(--primary);
        flex-shrink: 0;
    }

    .info-card-texto .ic-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .info-card-texto .ic-valor {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
    }

    /* Seção de pacotes */
    .sec-titulo {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 6px;
    }

    .sec-sub {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-bottom: 28px;
    }

    .pacotes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .mini-card-pacote {
        background: white;
        border-radius: 16px;
        border: 1px solid var(--border);
        overflow: hidden;
        transition: all 0.3s;
    }

        .mini-card-pacote:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        }

    .mini-card-topo {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        padding: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .mini-card-topo h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }

        .mini-card-topo .tipo-tag {
            font-size: 0.7rem;
            background: rgba(255,255,255,0.25);
            padding: 3px 10px;
            border-radius: 20px;
            font-weight: 600;
        }

    .mini-card-body {
        padding: 18px;
    }

    .mini-detalhes {
        display: flex;
        justify-content: space-between;
        background: #f9fafb;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 14px;
    }

    .md-item {
        text-align: center;
    }

        .md-item .md-label {
            display: block;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 2px;
        }

        .md-item .md-valor {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--text-main);
        }

    .mini-card-footer {
        padding: 14px 18px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .mini-preco {
        font-size: 1.3rem;
        font-weight: 900;
        color: var(--primary);
    }

    .mini-preco-sub {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    .btn-ver-pacote {
        background: var(--primary);
        color: white;
        padding: 9px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

        .btn-ver-pacote:hover {
            background: var(--accent);
            color: white;
        }

    .sem-pacotes {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        border: 2px dashed var(--border);
        color: var(--text-muted);
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 30px;
        font-size: 0.9rem;
    }

        .btn-voltar:hover {
            color: var(--accent);
        }
</style>

<div class="det-page">

    <!-- Hero -->
    <div class="det-hero">
        <span class="det-hero-badge @(internacional ? "badge-intl" : "badge-nac")">
            @(internacional ? "Internacional" : "Nacional")
        </span>
        <h1>@Model.Estado, @Model.Pais</h1>
        <p class="det-hero-sub">Explore tudo que este destino tem a oferecer</p>
    </div>

    <div class="container">

        <!-- Card de rota flutuante -->
        <div class="rota-card">
            <div class="rota-ponto">
                <div class="rp-label">Origem</div>
                <div class="rp-pais">@Model.OrigemPais</div>
                <div class="rp-estado">@Model.OrigemEstado</div>
            </div>
            <div class="rota-seta-box">
                <i class="fas fa-plane"></i>
                <span>Voo direto</span>
            </div>
            <div class="rota-ponto">
                <div class="rp-label">Destino</div>
                <div class="rp-pais">@Model.Pais</div>
                <div class="rp-estado">@Model.Estado</div>
            </div>
        </div>

        <!-- Botão voltar -->
        <a href="javascript:history.back()" class="btn-voltar">
            <i class="fas fa-arrow-left"></i> Voltar para Destinos
        </a>

        <!-- Info cards -->
        <div class="info-grid">
            <div class="info-card">
                <div class="info-card-icone"><i class="fas fa-globe-americas"></i></div>
                <div class="info-card-texto">
                    <div class="ic-label">País de destino</div>
                    <div class="ic-valor">@Model.Pais</div>
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icone"><i class="fas fa-map-marker-alt"></i></div>
                <div class="info-card-texto">
                    <div class="ic-label">Estado / Região</div>
                    <div class="ic-valor">@Model.Estado</div>
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icone"><i class="fas fa-plane-departure"></i></div>
                <div class="info-card-texto">
                    <div class="ic-label">Saindo de</div>
                    <div class="ic-valor">@Model.OrigemEstado, @Model.OrigemPais</div>
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-icone"><i class="fas fa-suitcase-rolling"></i></div>
                <div class="info-card-texto">
                    <div class="ic-label">Tipo</div>
                    <div class="ic-valor">@(internacional ? "Internacional" : "Nacional")</div>
                </div>
            </div>
        </div>

        <!-- Pacotes disponíveis -->
        <h2 class="sec-titulo">Pacotes disponíveis para este destino</h2>
        <p class="sec-sub">Escolha o pacote ideal e garanta sua vaga</p>

        @if (pacotes != null && pacotes.Any())
        {
            <div class="pacotes-grid">
                @foreach (var p in pacotes)
                {
                    string badgeClass = p.VagasDisponiveis > 5 ? "vagas-ok" :
                    p.VagasDisponiveis > 0 ? "vagas-alerta" : "vagas-esgotado";
                    string badgeTexto = p.VagasDisponiveis > 5 ? $"{p.VagasDisponiveis} vagas" :
                    p.VagasDisponiveis > 0 ? $"Últimas {p.VagasDisponiveis} vagas!" : "Esgotado";

                    <div class="mini-card-pacote">
                        <div class="mini-card-topo">
                            <h4>@p.Nome</h4>
                            <span class="tipo-tag">@p.TipoViagem</span>
                        </div>
                        <div class="mini-card-body">
                            <div class="mini-detalhes">
                                <div class="md-item">
                                    <span class="md-label">Duração</span>
                                    <span class="md-valor">@p.DuracaoDias dias</span>
                                </div>
                                <div class="md-item">
                                    <span class="md-label">Partida</span>
                                    <span class="md-valor">@p.DataPartida.ToString("dd/MM/yy")</span>
                                </div>
                                <div class="md-item">
                                    <span class="md-label">Retorno</span>
                                    <span class="md-valor">@p.DataRetorno.ToString("dd/MM/yy")</span>
                                </div>
                                <div class="md-item">
                                    <span class="md-label">Vagas</span>
                                    <span class="md-valor" style="color: @(p.VagasDisponiveis > 5 ? "#10b981" : p.VagasDisponiveis > 0 ? "#f59e0b" : "#ef4444")">
                                        @p.VagasDisponiveis
                                    </span>
                                </div>
                            </div>
                            <p style="font-size:0.87rem; color:var(--text-muted); line-height:1.5; margin:0;">
                                @(p.Descricao?.Length > 90 ? p.Descricao.Substring(0, 90) + "..." : p.Descricao)
                            </p>
                        </div>
                        <div class="mini-card-footer">
                            <div>
                                <div class="mini-preco-sub">Por pessoa</div>
                                <div class="mini-preco">@p.PrecoPorPessoa.ToString("C")</div>
                            </div>
                            <a asp-controller="Pacotes" asp-action="Detalhes" asp-route-id="@p.Id" class="btn-ver-pacote">
                                Ver pacote
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sem-pacotes">
                <i class="fas fa-box-open fa-3x mb-3" style="color:#cbd5e1;"></i>
                <h4>Nenhum pacote disponível ainda</h4>
                <p>Estamos preparando pacotes incríveis para este destino. Volte em breve!</p>
            </div>
        }

    </div>
</div>