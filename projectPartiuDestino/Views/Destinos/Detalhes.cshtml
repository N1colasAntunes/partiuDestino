@model projectPartiuDestino.Models.Destinos
@using projectPartiuDestino.Models
@{
    ViewData["Title"] = $"{Model.Pais} - {Model.Estado}";
    var voo = ViewBag.Voo as SelecaoVoo;
    int quantidadeAdultos = voo?.QuantidadeAdultos ?? 1;
    int quantidadeCriancas = voo?.QuantidadeCriancas ?? 0;
    int quantidadeTotal = voo?.QuantidadeTotal ?? 1;
}

<style>
    :root {
        --primary: #1e3a8a;
        --accent: #3b82f6;
        --success: #10b981;
        --text-muted: #6b7280;
        --border: #e5e7eb;
    }

    .det-dst-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 50px 0 80px;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .det-dst-hero {
        background: linear-gradient(135deg,var(--primary),var(--accent));
        padding: 50px 0 70px;
        color: white;
        text-align: center;
    }

        .det-dst-hero h1 {
            font-size: 2.4rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

    .det-dst-resumo {
        max-width: 900px;
        margin: -40px auto 40px;
        background: white;
        border-radius: 18px;
        padding: 26px 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .resumo-item {
        text-align: center;
        flex: 1;
        min-width: 130px;
    }

        .resumo-item span {
            display: block;
            font-size: .7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .resumo-item strong {
            font-size: 1.05rem;
            color: #1f2937;
        }

    .det-dst-layout {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .alerta-erro {
        background: #fee2e2;
        border: 1px solid #fca5a5;
        color: #991b1b;
        padding: 14px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .voo-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 24px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .link-alterar {
        color: var(--accent);
        font-weight: 700;
        font-size: .85rem;
        text-decoration: none;
    }

    .sec-titulo-h {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 6px;
        color: #1f2937;
    }

    .sec-sub-h {
        color: var(--text-muted);
        margin-bottom: 24px;
    }

    .hosp-bloco {
        background: white;
        border-radius: 18px;
        border: 1px solid var(--border);
        margin-bottom: 24px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0,0,0,.04);
    }

    .hosp-banner {
        height: 190px;
        position: relative;
        overflow: hidden;
    }

    .hosp-banner-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hosp-banner-fallback {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg,var(--primary),var(--accent));
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .hosp-banner-fallback i {
            font-size: 3rem;
            color: rgba(255,255,255,.35);
        }

    .hosp-conteudo {
        padding: 24px 28px;
    }

    .hosp-categoria-badge {
        display: inline-block;
        background: #eff6ff;
        color: var(--primary);
        font-size: .72rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        margin-bottom: 8px;
    }

    .btn-detalhes-hosp {
        background: var(--primary);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: .9rem;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .sem-hosp {
        text-align: center;
        padding: 50px 20px;
        background: white;
        border-radius: 16px;
        border: 2px dashed var(--border);
        color: var(--text-muted);
    }

    .btn-pular {
        background: #e5e7eb;
        color: #374151;
        border: none;
        padding: 14px 24px;
        border-radius: 14px;
        font-weight: 800;
        cursor: pointer;
        width: 100%;
        margin-top: 14px;
    }

    .modal-fundo {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.65);
        z-index: 99999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-caixa {
        background: white;
        width: 100%;
        border-radius: 18px;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
        overflow: hidden;
    }

    .modal-termos-caixa {
        max-width: 620px;
    }

    .modal-documentos-caixa {
        max-width: 760px;
    }

    .modal-header {
        padding: 22px 26px;
        border-bottom: 1px solid #e5e7eb;
    }

        .modal-header h3 {
            margin: 0;
            color: #1e3a8a;
            font-weight: 900;
        }

    .modal-body {
        padding: 24px 26px;
        color: #374151;
        font-size: .92rem;
        line-height: 1.6;
    }

    .modal-body-scroll {
        max-height: 430px;
        overflow-y: auto;
    }

    .modal-footer {
        padding: 18px 26px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        border: none;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 800;
        cursor: pointer;
    }

        .btn-primary:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

    .btn-secondary {
        background: #e5e7eb;
        color: #374151;
        border: none;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 800;
        cursor: pointer;
    }
</style>

<div class="det-dst-page">
    <div class="det-dst-hero">
        <h1>@Model.Pais — @Model.Estado</h1>
        <p>Saindo de @Model.OrigemEstado, @Model.OrigemPais</p>
    </div>

    <div class="det-dst-resumo">
        <div class="resumo-item"><span>Preço base / pessoa</span><strong style="color:var(--primary);">@Model.PrecoPorPessoa.ToString("C")</strong></div>
        <div class="resumo-item"><span>Viajantes</span><strong>@quantidadeTotal (@quantidadeAdultos adulto(s), @quantidadeCriancas criança(s))</strong></div>
        @if (voo != null)
        {
            <div class="resumo-item"><span>Classe</span><strong>@voo.ClasseViagem</strong></div>
        }
    </div>

    <div class="det-dst-layout">

        @if (TempData["Erro"] != null)
        {
            <div class="alerta-erro"><i class="fas fa-exclamation-circle"></i> @TempData["Erro"]</div>
        }

        @if (voo != null)
        {
            <div class="voo-card">
                <div>
                    <div style="font-weight:800;color:#1f2937;">
                        <i class="fas fa-plane" style="color:var(--accent);"></i>
                        Assentos: @voo.NumeroAssento
                    </div>
                </div>
                <a asp-controller="Destinos" asp-action="Passagem" asp-route-id="@Model.Id" class="link-alterar">
                    <i class="fas fa-edit"></i> Alterar passagem
                </a>
            </div>
        }

        <h2 class="sec-titulo-h">Hospedagem (opcional)</h2>
        <p class="sec-sub-h">Você pode escolher uma hospedagem para esta viagem, ou continuar sem ela.</p>

        @if (!Model.Hospedagens.Any())
        {
            <div class="sem-hosp">
                <i class="fas fa-bed fa-3x" style="color:#cbd5e1;"></i>
                <h4>Nenhuma hospedagem cadastrada para este destino</h4>
                <p>Você pode continuar a reserva apenas com a passagem.</p>
            </div>
        }
        else
        {
            @foreach (var hosp in Model.Hospedagens)
            {
                <div class="hosp-bloco">
                    <div class="hosp-banner">
                        @if (!string.IsNullOrEmpty(hosp.ImagemUrl))
                        {
                            <img src="@hosp.ImagemUrl" alt="@hosp.Nome" class="hosp-banner-img" loading="lazy"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="hosp-banner-fallback" style="display:none;"><i class="fas fa-hotel"></i></div>
                        }
                        else
                        {
                            <div class="hosp-banner-fallback"><i class="fas fa-hotel"></i></div>
                        }
                    </div>
                    <div class="hosp-conteudo">
                        @if (!string.IsNullOrEmpty(hosp.Categoria))
                        {
                            <span class="hosp-categoria-badge">@hosp.Categoria</span>
                        }
                        <h3 style="font-size:1.3rem;font-weight:900;color:#1f2937;margin:0 0 6px;">@hosp.Nome</h3>
                        @if (!string.IsNullOrEmpty(hosp.Endereco))
                        {
                            <p style="font-size:.9rem;color:var(--text-muted);"><i class="fas fa-map-marker-alt"></i> @hosp.Endereco</p>
                        }
                        @if (!string.IsNullOrEmpty(hosp.Descricao))
                        {
                            <p style="color:#4b5563;line-height:1.6;">@hosp.Descricao</p>
                        }
                        <a asp-controller="Destinos" asp-action="DetalhesHospedagem"
                           asp-route-destinoId="@Model.Id" asp-route-hospedagemId="@hosp.Id"
                           class="btn-detalhes-hosp">
                            Ver detalhes e escolher quarto
                        </a>
                    </div>
                </div>
            }
        }

        <button type="button" class="btn-pular" onclick="abrirModalTermos()">
            Continuar sem hospedagem <i class="fas fa-arrow-right"></i>
        </button>
    </div>
</div>

<!-- MODAL — POLÍTICAS E AVISOS -->
<div id="modalTermos" class="modal-fundo">
    <div class="modal-caixa modal-termos-caixa">
        <div class="modal-header">
            <h3>Termos e condições da reserva</h3>
            <p>Leia e aceite os termos para continuar.</p>
        </div>
        <div class="modal-body">
            <p>Ao continuar, você confirma que:</p>
            <ul style="padding-left:20px;">
                <li>Os dados dos viajantes deverão ser verdadeiros.</li>
                <li>Alterações em nomes, documentos, datas ou assentos podem gerar custos adicionais.</li>
                <li>A reserva depende da disponibilidade de passagens e vagas.</li>
                <li>Cancelamentos seguem as políticas da empresa e dos fornecedores.</li>
                <li>A confirmação final depende da validação dos dados e da finalização do pedido.</li>
            </ul>
            <label style="display:flex;gap:10px;margin-top:18px;font-weight:700;color:#1f2937;">
                <input type="checkbox" id="checkTermos" onchange="controlarBotaoTermos()" />
                <span>Li e aceito os termos da reserva.</span>
            </label>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="fecharModalTermos()">Cancelar</button>
            <button type="button" id="btnContinuarTermos" class="btn-primary" disabled onclick="continuarParaDocumentos()">Continuar</button>
        </div>
    </div>
</div>

<!-- MODAL — INFORMAÇÕES PESSOAIS E DOCUMENTOS -->
<div id="modalDocumentos" class="modal-fundo">
    <div class="modal-caixa modal-documentos-caixa">
        <div class="modal-header">
            <h3>Dados dos viajantes</h3>
            <p>Preencha os dados de todos os passageiros.</p>
        </div>

        <form asp-controller="Carrinho" asp-action="AdicionarDestino" method="post" id="formDocumentos" style="margin:0;">
            <input type="hidden" name="destinoId" value="@Model.Id" />
            <input type="hidden" name="quartoId" value="" />
            <input type="hidden" name="aceitouTermos" value="true" />
            <input type="hidden" name="quantidadeAdultos" value="@quantidadeAdultos" />
            <input type="hidden" name="quantidadeCriancas" value="@quantidadeCriancas" />
            <input type="hidden" name="quantidadeTotal" value="@quantidadeTotal" />

            <div class="modal-body modal-body-scroll">
                <div style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a;border-radius:14px;padding:14px 18px;margin-bottom:20px;font-weight:800;">
                    Total: @quantidadeAdultos adulto(s), @quantidadeCriancas criança(s) — @quantidadeTotal viajante(s)
                </div>
                <div id="camposViajantes"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="voltarParaTermos()">Voltar</button>
                <button type="submit" class="btn-primary">Adicionar ao carrinho</button>
            </div>
        </form>
    </div>
</div>

<script>
    const quantidadeAdultos = @quantidadeAdultos;
    const quantidadeCriancas = @quantidadeCriancas;
    const quantidadeTotal = @quantidadeTotal;

    function abrirModalTermos() {
        document.getElementById('checkTermos').checked = false;
        controlarBotaoTermos();
        document.getElementById('modalTermos').style.display = 'flex';
    }
    function fecharModalTermos() { document.getElementById('modalTermos').style.display = 'none'; }
    function controlarBotaoTermos() {
        const check = document.getElementById('checkTermos');
        const botao = document.getElementById('btnContinuarTermos');
        botao.disabled = !check.checked;
        botao.style.background = check.checked ? '#1e3a8a' : '#9ca3af';
        botao.style.cursor = check.checked ? 'pointer' : 'not-allowed';
    }
    function continuarParaDocumentos() {
        if (!document.getElementById('checkTermos').checked) {
            alert('Você precisa aceitar os termos para continuar.');
            return;
        }
        document.getElementById('modalTermos').style.display = 'none';
        gerarCamposViajantes();
        document.getElementById('modalDocumentos').style.display = 'flex';
    }
    function voltarParaTermos() {
        document.getElementById('modalDocumentos').style.display = 'none';
        document.getElementById('modalTermos').style.display = 'flex';
    }
    function gerarCamposViajantes() {
        const container = document.getElementById('camposViajantes');
        container.innerHTML = '';
        let contador = 1;
        for (let i = 1; i <= quantidadeAdultos; i++) { container.innerHTML += criarCardViajante(contador, 'Adulto'); contador++; }
        for (let i = 1; i <= quantidadeCriancas; i++) { container.innerHTML += criarCardViajante(contador, 'Criança'); contador++; }
    }
    function criarCardViajante(numero, tipo) {
        return `
            <div style="border:1px solid #e5e7eb;border-radius:16px;padding:18px;margin-bottom:16px;background:#ffffff;">
                <h4 style="margin:0 0 14px;color:#1f2937;font-weight:900;">Viajante ${numero} — ${tipo}</h4>
                <input type="hidden" name="tiposViajantes" value="${tipo}" />
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div>
                        <label style="display:block;font-weight:700;color:#374151;margin-bottom:6px;">Nome completo</label>
                        <input type="text" name="nomesViajantes" required placeholder="Digite o nome completo"
                               style="width:100%;padding:12px;border:1px solid #d1d5db;border-radius:10px;" />
                    </div>
                    <div>
                        <label style="display:block;font-weight:700;color:#374151;margin-bottom:6px;">Documento</label>
                        <input type="text" name="documentosViajantes" required placeholder="CPF ou documento"
                               style="width:100%;padding:12px;border:1px solid #d1d5db;border-radius:10px;" />
                    </div>
                    <div>
                        <label style="display:block;font-weight:700;color:#374151;margin-bottom:6px;">Data de nascimento</label>
                        <input type="date" name="nascimentosViajantes" required
                               style="width:100%;padding:12px;border:1px solid #d1d5db;border-radius:10px;" />
                    </div>
                </div>
            </div>`;
    }
    document.getElementById('formDocumentos').onsubmit = function () {
        const nomes = document.getElementsByName('nomesViajantes');
        if (nomes.length !== quantidadeTotal) { alert('A quantidade de viajantes está incorreta.'); return false; }
        for (let i = 0; i < quantidadeTotal; i++) {
            if (!nomes[i].value.trim()) { alert('Preencha o nome de todos os viajantes.'); return false; }
        }
        return true;
    };
</script>