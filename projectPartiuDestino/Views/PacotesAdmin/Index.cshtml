@{
    ViewData["Title"] = "Pacotes - Painel Administrativo";
}
@using MySql.Data.MySqlClient

@{
    string conexao = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
}

<style>
    /* Estilo para a métrica (Card) */
    .metric-info {
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        display: inline-block;
        margin-bottom: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .metric-info h4 {
            margin: 0;
            color: #64748b;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .metric-info p {
            margin: 10px 0 0 0;
            font-size: 2rem;
            font-weight: bold;
            color: #1e3a8a;
        }

    /* Estilo para o título */
    h2 {
        font-family: 'Segoe UI', sans-serif;
        color: #1e3a8a;
        margin-bottom: 20px;
        font-weight: 800;
    }

    /* Estilo para a tabela (Limpa e Moderna) */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none !important; /* Remove o visual do border="1" */
        font-family: 'Segoe UI', sans-serif;
        margin-bottom: 30px;
    }

    th {
        background-color: #1e3a8a;
        color: #ffffff;
        text-align: left;
        padding: 15px !important;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 12px 15px !important;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 0.9rem;
    }

    tr:hover {
        background-color: #f8fafc;
    }

    /* Destaque para o preço e vagas */
    td:nth-child(9) {
        font-weight: bold;
        color: #1e3a8a;
    }

    td:nth-child(10) {
        font-weight: bold;
        text-align: center;
    }

    /* Barra Lateral (Sidebar) */
    .admin-sidebar {
        width: 260px;
        background-color: #1e3a8a;
        color: white;
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 40px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        flex-grow: 1;
    }

    .sidebar-item {
        margin-bottom: 10px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 15px;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.3s;
        font-weight: 500;
    }

        .sidebar-link:hover, .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .sidebar-link i {
            width: 20px;
            text-align: center;
        }
</style>

<aside class="admin-sidebar">
    <ul class="sidebar-menu">
        <li class="sidebar-item">
            <a href="/Admin/Index" class="sidebar-link active">
                <i class="fas fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/DestinosAdmin/Index" class="sidebar-link">
                <i class="fas fa-map-marked-alt"></i>
                <span>Destinos</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/PacotesAdmin/Index" class="sidebar-link">
                <i class="fas fa-suitcase-rolling"></i>
                <span>Pacotes</span>
            </a>
        </li>
        <li class="sidebar-item">
            <a href="/ViagemPersonalizadaAdmin/Index" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Viagens Personalizadas</span>
            </a>
        </li>

        <li class="sidebar-item">
            <a href="/Usuarios/Index" class="sidebar-link">
                <i class="fas fa-users"></i>
                <span>Usuários</span>
            </a>
        </li>
    </ul>
    <div class="sidebar-footer">
        <a href="/" class="sidebar-link">
            <i class="fas fa-sign-out-alt"></i>
            <span>Sair do Painel</span>
        </a>
    </div>
</aside>

<div class="metric-info">
    <h4>Quantidade de Pacotes</h4>

    <p>
        @{
            int totalPacotes = 0;

            using (MySqlConnection conn = new MySqlConnection(conexao))
            {
                conn.Open();

                string sqlTotal = "SELECT COUNT(*) FROM pacotes";

                MySqlCommand cmdTotal = new MySqlCommand(sqlTotal, conn);

                totalPacotes = Convert.ToInt32(cmdTotal.ExecuteScalar());
            }
        }

        @totalPacotes
    </p>
</div>

<a asp-controller="PacotesAdmin"
   asp-action="Criar"
   style="background:#16a34a;
          color:white;
          padding:10px 15px;
          text-decoration:none;
          border-radius:6px;
          display:inline-block;
          margin-bottom:20px;">
    + Novo Pacote
</a>

<h2>Pacotes Cadastrados</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>ID Destino</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Tipo de Viagem</th>
        <th>Duração (Dias)</th>
        <th>Data Partida</th>
        <th>Data Retorno</th>
        <th>Preço por Pessoa</th>
        <th>Vagas Disponíveis</th>
        <th>Ações</th>
    </tr>

    @{
        using (MySqlConnection conn = new MySqlConnection(conexao))
        {
            conn.Open();

            string sql = "SELECT * FROM pacotes";

            MySqlCommand cmd = new MySqlCommand(sql, conn);

            MySqlDataReader reader = cmd.ExecuteReader();

            while (reader.Read())
            {
                <tr>
                    <td>@reader["id"]</td>
                    <td>@reader["destino_id"]</td>
                    <td>@reader["nome"]</td>
                    <td>@reader["descricao"]</td>
                    <td>@reader["tipo_viagem"]</td>
                    <td>@reader["duracao_dias"]</td>

                    <td>
                        @Convert.ToDateTime(reader["data_partida"]).ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @Convert.ToDateTime(reader["data_retorno"]).ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        R$ @reader["preco_por_pessoa"]
                    </td>

                    <td>@reader["vagas_disponiveis"]</td>

                    <td style="display:flex;gap:8px;">

                        <a asp-controller="PacotesAdmin"
                           asp-action="Editar"
                           asp-route-id="@reader["id"]"
                           style="background:#2563eb;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;">
                            Editar
                        </a>

                        <form asp-action="Delete"
                              asp-controller="PacotesAdmin"
                              method="post"
                              onsubmit="return confirm('Tem certeza que deseja excluir este pacote?');">

                            <input type="hidden" name="id" value="@reader["id"]" />

                            <button type="submit"
                                    style="background:#ef4444;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer;">
                                Excluir
                            </button>

                        </form>

                    </td>
                </tr>
            }
        }
    }
</table>