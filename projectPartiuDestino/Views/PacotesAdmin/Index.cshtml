@{
    ViewData["Title"] = "Pacotes - Painel Administrativo";
}
@using MySql.Data.MySqlClient

@{
    string conexao = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
}

<style>
    /* Estilo para a métrica (Card) */
    .metric-info {
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #e2e8f0;
        display: inline-block;
        margin-bottom: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .metric-info h4 {
            margin: 0;
            color: #64748b;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .metric-info p {
            margin: 10px 0 0 0;
            font-size: 2rem;
            font-weight: bold;
            color: #1e3a8a;
        }

    /* Estilo para o título */
    h2 {
        font-family: 'Segoe UI', sans-serif;
        color: #1e3a8a;
        margin-bottom: 20px;
        font-weight: 800;
    }

    /* Estilo para a tabela (Limpa e Moderna) */
    table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none !important; /* Remove o visual do border="1" */
        font-family: 'Segoe UI', sans-serif;
        margin-bottom: 30px;
    }

    th {
        background-color: #1e3a8a;
        color: #ffffff;
        text-align: left;
        padding: 15px !important;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    td {
        padding: 12px 15px !important;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 0.9rem;
    }

    tr:hover {
        background-color: #f8fafc;
    }

    /* Destaque para o preço e vagas */
    td:nth-child(9) {
        font-weight: bold;
        color: #1e3a8a;
    }

    td:nth-child(10) {
        font-weight: bold;
        text-align: center;
    }

    /* Estilo para o botão Voltar */
    .sidebar-item {
        list-style: none;
        margin-top: 10px;
    }

    .sidebar-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #1e3a8a;
        font-weight: 600;
        font-family: 'Segoe UI', sans-serif;
        padding: 10px 20px;
        border: 2px solid #1e3a8a;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .sidebar-link:hover {
            background-color: #1e3a8a;
            color: #ffffff;
            transform: translateX(-5px);
        }

        .sidebar-link i {
            font-size: 0.9rem;
        }
</style>

<div class="metric-info">
    <h4>Quantidade de Pacotes</h4>

    <p>
        @{
            int totalPacotes = 0;

            using (MySqlConnection conn = new MySqlConnection(conexao))
            {
                conn.Open();

                string sqlTotal = "SELECT COUNT(*) FROM pacotes";

                MySqlCommand cmdTotal = new MySqlCommand(sqlTotal, conn);

                totalPacotes = Convert.ToInt32(cmdTotal.ExecuteScalar());
            }
        }

        @totalPacotes
    </p>
</div>

<a asp-controller="PacotesAdmin"
   asp-action="Criar"
   style="background:#16a34a;
          color:white;
          padding:10px 15px;
          text-decoration:none;
          border-radius:6px;
          display:inline-block;
          margin-bottom:20px;">
    + Novo Pacote
</a>

<h2>Pacotes Cadastrados</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>ID Destino</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Tipo de Viagem</th>
        <th>Duração (Dias)</th>
        <th>Data Partida</th>
        <th>Data Retorno</th>
        <th>Preço por Pessoa</th>
        <th>Vagas Disponíveis</th>
        <th>Ações</th>
    </tr>

    @{
        using (MySqlConnection conn = new MySqlConnection(conexao))
        {
            conn.Open();

            string sql = "SELECT * FROM pacotes";

            MySqlCommand cmd = new MySqlCommand(sql, conn);

            MySqlDataReader reader = cmd.ExecuteReader();

            while (reader.Read())
            {
                <tr>
                    <td>@reader["id"]</td>
                    <td>@reader["destino_id"]</td>
                    <td>@reader["nome"]</td>
                    <td>@reader["descricao"]</td>
                    <td>@reader["tipo_viagem"]</td>
                    <td>@reader["duracao_dias"]</td>

                    <td>
                        @Convert.ToDateTime(reader["data_partida"]).ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @Convert.ToDateTime(reader["data_retorno"]).ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        R$ @reader["preco_por_pessoa"]
                    </td>

                    <td>@reader["vagas_disponiveis"]</td>

                    <!-- 🔥 BOTÃO EXCLUIR -->
                    <td>
                        <form asp-action="Delete" asp-controller="PacotesAdmin" method="post"
                              onsubmit="return confirm('Tem certeza que deseja excluir este pacote?');">

                            <input type="hidden" name="id" value="@reader["id"]" />

                            <button type="submit"
                                    style="background:#ef4444;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer;">
                                Excluir
                            </button>

                        </form>
                    </td>
                </tr>
            }
        }
    }
</table>

<br>

<li class="sidebar-item">
    <a asp-controller="Admin" asp-action="Index" class="sidebar-link">
        <i class="fas fa-arrow-left"></i>
        <span>Voltar</span>
    </a>
</li>