@{
    ViewData["Title"] = "Cadastrar Pacote";
}

<style>
    h2 {
        color: #1e3a8a;
        font-weight: 800;
        margin-bottom: 30px;
        position: relative;
        padding-bottom: 10px;
    }

        h2::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 4px;
            background: #3b82f6;
            border-radius: 2px;
        }

    .form-wrapper {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0e7ff;
        color: #1e3a8a;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 700;
        text-decoration: none;
        margin-bottom: 24px;
        transition: 0.2s;
    }

        .btn-voltar:hover {
            background: #c7d2fe;
        }

    form {
        background: white;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

        form div {
            display: flex;
            flex-direction: column;
        }

    label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
        font-size: .9rem;
    }

    input, textarea, select {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        font-size: .95rem;
        box-sizing: border-box;
        transition: .2s;
    }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #3b82f6;
            background: white;
            box-shadow: 0 0 0 4px rgba(59,130,246,.1);
        }

    .span3 {
        grid-column: span 3;
    }

    textarea {
        min-height: 120px;
        resize: vertical;
    }

    /* bloco da imagem */
    .imagem-bloco {
        grid-column: span 3;
        border: 2px dashed #c7d2fe;
        border-radius: 12px;
        padding: 20px;
        background: #f8faff;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

        .imagem-bloco label {
            color: #1e3a8a;
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 0;
        }

        .imagem-bloco small {
            color: #64748b;
            font-size: .82rem;
        }

    #previewImagem {
        width: 180px;
        height: 120px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid #c7d2fe;
        display: none;
    }

    .form-actions {
        grid-column: span 3;
        margin-top: 10px;
    }

    button[type="submit"] {
        width: 100%;
        padding: 16px;
        background: #16a34a;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: .3s;
    }

        button[type="submit"]:hover {
            transform: translateY(-1px);
            filter: brightness(1.1);
        }

    @@media (max-width: 900px) {
        form {
            grid-template-columns: 1fr;
        }

        .span3, .imagem-bloco, .form-actions {
            grid-column: span 1;
        }
    }
</style>

<div class="form-wrapper">

    <h2>Cadastrar Pacote</h2>

    <a class="btn-voltar" asp-action="Index">&#8592; Voltar para Pacotes</a>

    <!-- enctype="multipart/form-data" é OBRIGATÓRIO para o upload de arquivo funcionar  -->
    <form method="post" asp-action="Criar" enctype="multipart/form-data">

        <div>
            <label>ID do Destino</label>
            <input type="number" name="destino_id" required />
        </div>

        <div>
            <label>Nome</label>
            <input type="text" name="nome" required />
        </div>

        <div>
            <label>Tipo de Viagem</label>
            <input type="text" name="tipo_viagem" />
        </div>

        <div>
            <label>Duração (dias)</label>
            <input type="number" name="duracao_dias" />
        </div>

        <div>
            <label>Data de Partida</label>
            <input type="date" name="data_partida" />
        </div>

        <div>
            <label>Data de Retorno</label>
            <input type="date" name="data_retorno" />
        </div>

        <div>
            <label>Preço por Pessoa (R$)</label>
            <input type="number" step="0.01" name="preco_por_pessoa" required />
        </div>

        <div>
            <label>Vagas Disponíveis</label>
            <input type="number" name="vagas_disponiveis" />
        </div>

        <div></div>

        <div class="span3">
            <label>Descrição</label>
            <textarea name="descricao"></textarea>
        </div>

        <!-- BLOCO DA IMAGEM  -->
        <div class="imagem-bloco">
            <label>🖼️ Imagem do Pacote</label>

            <!-- OPÇÃO 1: fazer upload de um arquivo do computador  -->
            <div>
                <label>Opção 1 — Enviar arquivo do computador</label>
                <input type="file" name="imagemArquivo" accept="image/*"
                       onchange="mostrarPreview(this)" />
                <small>Formatos aceitos: JPG, PNG, WEBP</small>
            </div>

            <!-- OPÇÃO 2: colar uma URL externa (Unsplash, Google etc.)  -->
            <div>
                <label>Opção 2 — Ou cole uma URL de imagem</label>
                <input type="text" name="imagem_url"
                       placeholder="https://images.unsplash.com/..."
                       oninput="mostrarPreviewUrl(this.value)" />
                <small>Se preencher os dois, o arquivo enviado tem prioridade.</small>
            </div>

            <!-- preview da imagem antes de salvar  -->
            <img id="previewImagem" src="" alt="Preview da imagem" />
        </div>

        <div class="form-actions">
            <button type="submit">Salvar Pacote</button>
        </div>

    </form>
</div>

<script>
    // Mostra preview quando o admin seleciona um arquivo
    function mostrarPreview(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.getElementById('previewImagem');
                img.src = e.target.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Mostra preview quando o admin digita/cola uma URL
    function mostrarPreviewUrl(url) {
        var img = document.getElementById('previewImagem');
        if (url) {
            img.src = url;
            img.style.display = 'block';
        } else {
            img.style.display = 'none';
        }
    }
</script>
