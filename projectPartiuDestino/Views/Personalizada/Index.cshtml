@{
    ViewData["Title"] = "Planejamento Premium - Partiu Destino";
}

<style>
    /* ============================================
           ESTILO PLANEJAMENTO PREMIUM
           ============================================ */

    :root {
        --primary: #1e3a8a;
        --primary-light: #eff6ff;
        --secondary: #3b82f6;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .planejamento-wrapper {
        background-color: var(--bg-body);
        padding: 80px 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-main);
    }

    .container-premium {
        max-width: 850px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Cabeçalho de Impacto */
    .header-premium {
        text-align: center;
        margin-bottom: 60px;
    }

        .header-premium .badge-top {
            background-color: var(--primary-light);
            color: var(--primary);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: inline-block;
            margin-bottom: 15px;
        }

        .header-premium h1 {
            font-size: 2.8rem;
            font-weight: 900;
            color: #111827;
            letter-spacing: -1px;
            margin-bottom: 15px;
        }

        .header-premium p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

    /* Cards de Seção */
    .card-secao {
        background: var(--white);
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
        border: 1px solid var(--border);
        transition: transform 0.3s ease;
    }

        .card-secao:hover {
            transform: translateY(-2px);
        }

    .titulo-secao-premium {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 35px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f1f5f9;
    }

        .titulo-secao-premium i {
            width: 45px;
            height: 45px;
            background-color: var(--primary-light);
            color: var(--primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .titulo-secao-premium h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: #1e293b;
        }

    /* Inputs e Labels */
    .form-grid-premium {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .group-premium {
        display: flex;
        flex-direction: column;
    }

        .group-premium label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .input-premium {
        padding: 14px 18px;
        border: 1.5px solid var(--border);
        border-radius: 14px;
        font-size: 0.95rem;
        background-color: #fcfcfd;
        transition: all 0.2s ease;
    }

        .input-premium:focus {
            outline: none;
            border-color: var(--primary);
            background-color: var(--white);
            box-shadow: 0 0 0 4px rgba(30, 58, 138, 0.08);
        }

    /* Botões de Seleção Estilizados (Chips) */
    .chips-group {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .chip-item {
        cursor: pointer;
    }

        .chip-item input {
            display: none;
        }

    .chip-label {
        padding: 10px 20px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: all 0.2s;
        display: inline-block;
    }

    .chip-item input:checked + .chip-label {
        background-color: var(--primary);
        border-color: var(--primary);
        color: var(--white);
        box-shadow: 0 4px 10px rgba(30, 58, 138, 0.2);
    }

    /* Botão de Ação Principal */
    .btn-enviar {
        width:500px;
        background: linear-gradient(135deg, var(--primary) 0%, #1e40af 100%);
        color: var(--white);
        border: none;
        padding: 20px;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        box-shadow: 0 10px 20px rgba(30, 58, 138, 0.15);
        margin-left:160px;
    }

        .btn-enviar:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(30, 58, 138, 0.25);
        }

        .btn-enviar i {
            font-size: 1.2rem;
            transition: transform 0.3s ease;
        }

        .btn-enviar:hover i {
            transform: translateX(5px);
        }

    /* Responsividade */
    @@media (max-width: 768px) {
        .form-grid-premium {
            grid-template-columns: 1fr;
        }

        .header-premium h1 {
            font-size: 2rem;
        }

        .card-secao {
            padding: 25px;
        }
    }
</style>

<div class="planejamento-wrapper">
    <div class="container-premium">

        <!-- Header -->
        <div class="header-premium">
            <span class="badge-top">Consultoria Exclusiva</span>
            <h1>Sua Jornada Começa Aqui</h1>
            <p>Personalize cada detalhe da sua próxima aventura. Nossa equipe de especialistas transformará seus desejos em um roteiro inesquecível.</p>
        </div>

        <form action="#" method="post">

            <!-- Seção 1: Identificação -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-user-tie"></i>
                    <h3>Identificação Pessoal</h3>
                </div>
                <div class="form-grid-premium">
                    <div class="group-premium">
                        <label><i class="fas fa-signature"></i> Nome Completo</label>
                        <input type="text" class="input-premium" placeholder="Ex: Maria Oliveira" required />
                    </div>
                    <div class="group-premium">
                        <label><i class="fas fa-id-card"></i> CPF</label>
                        <input type="text" class="input-premium" placeholder="000.000.000-00" />
                    </div>
                    <div class="group-premium">
                        <label><i class="fas fa-envelope"></i> E-mail para Contato</label>
                        <input type="email" class="input-premium" placeholder="seu@email.com" required />
                    </div>
                    <div class="group-premium">
                        <label><i class="fab fa-whatsapp"></i> WhatsApp</label>
                        <input type="tel" class="input-premium" placeholder="(00) 00000-0000" required />
                    </div>
                </div>
            </div>

            <!-- Seção 2: O Destino -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-map-marked-alt"></i>
                    <h3>Destino & Estadia</h3>
                </div>
                <div class="form-grid-premium">
                    <div class="group-premium">
                        <label>Para onde deseja ir?</label>
                        <input type="text" class="input-premium" placeholder="Ex: Maldivas, Gramado, Roma..." />
                    </div>
                    <div class="group-premium">
                        <label>Tipo de Hospedagem</label>
                        <select class="input-premium">
                            <option value="luxo">Resort 5 Estrelas</option>
                            <option value="boutique">Hotel Boutique</option>
                            <option value="conforto" selected>Hotel Conforto (4*)</option>
                            <option value="casa">Vila / Casa Privativa</option>
                            <option value="nenhuma">Outro</option>
                        </select>
                    </div>
                    <div class="group-premium">
                        <label>Data de Partida</label>
                        <input type="date" class="input-premium" />
                    </div>
                    <div class="group-premium">
                        <label>Duração (Dias)</label>
                        <input type="number" class="input-premium" value="7" min="1" />
                    </div>
                </div>
            </div>

            <!-- Seção 3: Experiência -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-cocktail"></i>
                    <h3>Estilo da Experiência</h3>
                </div>
                <div class="group-premium mb-4">
                    <label>Qual o clima da viagem?</label>
                    <div class="chips-group">
                        <label class="chip-item">
                            <input type="radio" name="clima" value="romance" checked>
                            <span class="chip-label">Romance / Lua de Mel</span>
                        </label>
                        <label class="chip-item">
                            <input type="radio" name="clima" value="familia">
                            <span class="chip-label">Diversão em Família</span>
                        </label>
                        <label class="chip-item">
                            <input type="radio" name="clima" value="aventura">
                            <span class="chip-label">Aventura & Natureza</span>
                        </label>
                        <label class="chip-item">
                            <input type="radio" name="clima" value="gastronomia">
                            <span class="chip-label">Gastronomia & Cultura</span>
                        </label>
                        <label class="chip-item">
                            <input type="radio" name="clima" value="relax">
                            <span class="chip-label">Relaxamento / SPA</span>
                        </label>
                        <label class="chip-item">
                            <input type="radio" name="clima" value="outro">
                            <span class="chip-label">Outros</span>
                        </label>
                    </div>
                </div>
                <div class="form-grid-premium">
                    <div class="group-premium">
                        <label>Orçamento por Pessoa</label>
                        <select class="input-premium">
                            <option value="1">Até R$ 3.000</option>
                            <option value="2">R$ 3.000 a R$ 7.000</option>
                            <option value="3">R$ 7.000 a R$ 15.000</option>
                            <option value="4">Acima de R$ 15.000</option>
                        </select>
                    </div>
                    <div class="group-premium">
                        <label>Viajantes</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="input-premium w-50" placeholder="Adultos" />
                            <input type="number" class="input-premium w-50" placeholder="Crianças"  />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Seção 4: Detalhes Finais -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-comment-dots"></i>
                    <h3>Desejos Especiais</h3>
                </div>
                <div class="group-premium">
                    <label>Conte-nos o que não pode faltar nessa viagem</label>
                    <textarea class="input-premium" rows="5" placeholder="Ex: Jantar romântico na praia, passeio de balão, guia em português..."></textarea>
                </div>
            </div>

            <!-- Botão de Envio -->
            <button type="submit" class="btn-enviar">
                <span>Enviar Planejamento</span>
                <i class="fas fa-paper-plane"></i>
            </button>

        </form>

        <div class="text-center mt-5" style="color: var(--text-muted); font-size: 0.9rem;">
            <p><i class="fas fa-shield-alt me-2"></i> Seus dados estão protegidos e serão usados apenas para esta consultoria.</p>
        </div>

    </div>
</div>
