<script>
    document.addEventListener("DOMContentLoaded", function () {

        const cpfInput = document.getElementById("cpfInput");
        const whatsappInput = document.getElementById("whatsappInput");
        const duracaoInput = document.getElementById("duracaoInput");
        const adultosInput = document.getElementById("adultosInput");
        const criancasInput = document.getElementById("criancasInput");
        const idososInput = document.getElementById("idososInput");
        const dataPartida = document.getElementById("dataPartida");

        function somenteNumeros(valor) {
            return valor.replace(/\D/g, "");
        }

        function aplicarMascaraCpf(input) {
            if (!input) return;

            input.addEventListener("input", function () {
                let valor = somenteNumeros(input.value);

                valor = valor.replace(/^(\d{3})(\d)/, "$1.$2");
                valor = valor.replace(/^(\d{3})\.(\d{3})(\d)/, "$1.$2.$3");
                valor = valor.replace(/\.(\d{3})(\d)/, ".$1-$2");

                input.value = valor.substring(0, 14);
            });
        }

        function aplicarMascaraTelefone(input) {
            if (!input) return;

            input.addEventListener("input", function () {
                let valor = somenteNumeros(input.value).substring(0, 11);

                if (valor.length <= 10) {
                    valor = valor.replace(/^(\d{2})(\d)/, "($1) $2");
                    valor = valor.replace(/(\d{4})(\d)/, "$1-$2");
                } else {
                    valor = valor.replace(/^(\d{2})(\d)/, "($1) $2");
                    valor = valor.replace(/(\d{5})(\d)/, "$1-$2");
                }

                input.value = valor;
            });
        }

        function aplicarSomenteNumeros(input, minimo, maximo, padraoQuandoVazio) {
            if (!input) return;

            input.addEventListener("input", function () {
                input.value = somenteNumeros(input.value);
            });

            input.addEventListener("blur", function () {
                let valor = input.value === "" ? padraoQuandoVazio : parseInt(input.value);

                if (isNaN(valor)) {
                    valor = padraoQuandoVazio;
                }

                if (valor < minimo) {
                    valor = minimo;
                }

                if (valor > maximo) {
                    valor = maximo;
                }

                input.value = valor;
            });
        }

        function aplicarDataMinima() {
            if (!dataPartida) return;

            const hoje = new Date();
            const ano = hoje.getFullYear();
            const mes = String(hoje.getMonth() + 1).padStart(2, "0");
            const dia = String(hoje.getDate()).padStart(2, "0");

            dataPartida.min = `${ano}-${mes}-${dia}`;
        }

        aplicarMascaraCpf(cpfInput);
        aplicarMascaraTelefone(whatsappInput);

        aplicarSomenteNumeros(duracaoInput, 1, 365, 1);
        aplicarSomenteNumeros(adultosInput, 1, 30, 1);
        aplicarSomenteNumeros(criancasInput, 0, 30, 0);
        aplicarSomenteNumeros(idososInput, 0, 30, 0);

        aplicarDataMinima();

    });
</script>