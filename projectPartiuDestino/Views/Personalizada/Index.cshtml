@{
    ViewData["Title"] = "Planejamento Premium - Partiu Destino";
}

<style>
    :root {
        --primary: #1e3a8a;
        --primary-light: #eff6ff;
        --secondary: #3b82f6;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --bg-body: #f8fafc;
        --white: #ffffff;
        --border: #e5e7eb;
    }

    .planejamento-wrapper {
        background-color: var(--bg-body);
        padding: 80px 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-main);
    }

    .container-premium {
        max-width: 850px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .header-premium {
        text-align: center;
        margin-bottom: 60px;
    }

        .header-premium .badge-top {
            background-color: var(--primary-light);
            color: var(--primary);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: inline-block;
            margin-bottom: 15px;
        }

        .header-premium h1 {
            font-size: 2.8rem;
            font-weight: 900;
            color: #111827;
            letter-spacing: -1px;
            margin-bottom: 15px;
        }

        .header-premium p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

    .card-secao {
        background: var(--white);
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 0, 0, 0.03);
        border: 1px solid var(--border);
    }

    .titulo-secao-premium {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 35px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f1f5f9;
    }

        .titulo-secao-premium i {
            width: 45px;
            height: 45px;
            background-color: var(--primary-light);
            color: var(--primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .titulo-secao-premium h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: #1e293b;
        }

    .form-grid-premium {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .group-premium {
        display: flex;
        flex-direction: column;
    }

        .group-premium label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 10px;
        }

    .input-premium {
        padding: 14px 18px;
        border: 1.5px solid var(--border);
        border-radius: 14px;
        font-size: 0.95rem;
        background-color: #fcfcfd;
    }

    .chips-group {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .chip-item input {
        display: none;
    }

    .chip-label {
        padding: 10px 20px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
        display: inline-block;
        cursor: pointer;
    }

    .chip-item input:checked + .chip-label {
        background-color: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    .btn-enviar {
        width: 500px;
        background: linear-gradient(135deg, var(--primary) 0%, #1e40af 100%);
        color: white;
        border: none;
        padding: 20px;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        margin-left: 160px;
    }

    @@media (max-width: 768px) {
        .form-grid-premium {
            grid-template-columns: 1fr;
        }

        .btn-enviar {
            width: 100%;
            margin-left: 0;
        }
    }
</style>

<div class="planejamento-wrapper">
    <div class="container-premium">

        <div class="header-premium">
            <span class="badge-top">Consultoria Exclusiva</span>
            <h1>Sua Jornada Começa Aqui</h1>
            <p>Personalize cada detalhe da sua próxima aventura.</p>
        </div>

        <form method="post">

            <!-- IDENTIFICAÇÃO -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-user-tie"></i>
                    <h3>Identificação Pessoal</h3>
                </div>

                <div class="group-premium">
                    <label><i class="fas fa-signature"></i> Nome Completo</label>

                    <input type="text"
                           name="nomeCompleto"
                           class="input-premium"
                           placeholder="Ex: Maria Oliveira"
                           required />
                </div>

                <div class="group-premium">
                    <label><i class="fas fa-id-card"></i> CPF</label>

                    <input type="text"
                           name="cpf"
                           class="input-premium"
                           placeholder="000.000.000-00" />
                </div>

                <div class="group-premium">
                    <label><i class="fas fa-envelope"></i> E-mail para Contato</label>

                    <input type="email"
                           name="email"
                           class="input-premium"
                           placeholder="seu@email.com"
                           required />
                </div>

                <div class="group-premium">
                    <label><i class="fab fa-whatsapp"></i> WhatsApp</label>

                    <input type="tel"
                           name="whatsapp"
                           class="input-premium"
                           placeholder="(00) 00000-0000"
                           required />
                </div>
            </div>

            <!-- DESTINO -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-map-marked-alt"></i>
                    <h3>Destino & Estadia</h3>
                </div>

                <div class="form-grid-premium">

                    <div class="group-premium">
                        <label>Destino</label>
                        <input type="text"
                               name="destino"
                               class="input-premium" />
                    </div>

                    <div class="group-premium">
                        <label>Hospedagem</label>
                        <select name="hospedagem" class="input-premium">
                            <option value="Resort 5 Estrelas">Resort 5 Estrelas</option>
                            <option value="Hotel Boutique">Hotel Boutique</option>
                            <option value="Hotel Conforto">Hotel Conforto</option>
                            <option value="Casa Privativa">Casa Privativa</option>
                        </select>
                    </div>

                    <div class="group-premium">
                        <label>Data de Partida</label>
                        <input type="date"
                               name="dataPartida"
                               class="input-premium" />
                    </div>

                    <div class="group-premium">
                        <label>Duração (dias)</label>
                        <input type="number"
                               name="duracaoDias"
                               class="input-premium"
                               value="7"
                               min="1" />
                    </div>

                </div>
            </div>

            <!-- EXPERIÊNCIA -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-cocktail"></i>
                    <h3>Estilo da Experiência</h3>
                </div>

                <div class="group-premium mb-4">
                    <label>Clima da viagem</label>

                    <div class="chips-group">

                        <label class="chip-item">
                            <input type="radio" name="climaViagem" value="Romance" checked>
                            <span class="chip-label">Romance</span>
                        </label>

                        <label class="chip-item">
                            <input type="radio" name="climaViagem" value="Família">
                            <span class="chip-label">Família</span>
                        </label>

                        <label class="chip-item">
                            <input type="radio" name="climaViagem" value="Aventura">
                            <span class="chip-label">Aventura</span>
                        </label>

                        <label class="chip-item">
                            <input type="radio" name="climaViagem" value="Gastronomia">
                            <span class="chip-label">Gastronomia</span>
                        </label>

                    </div>
                </div>

                <div class="form-grid-premium">

                    <div class="group-premium">
                        <label>Orçamento</label>

                        <select name="orcamento" class="input-premium">
                            <option value="Até R$ 3.000">Até R$ 3.000</option>
                            <option value="R$ 3.000 a R$ 7.000">R$ 3.000 a R$ 7.000</option>
                            <option value="R$ 7.000 a R$ 15.000">R$ 7.000 a R$ 15.000</option>
                            <option value="Acima de R$ 15.000">Acima de R$ 15.000</option>
                        </select>
                    </div>

                    <div class="group-premium">
                        <label>Viajantes</label>

                        <div class="d-flex gap-2">

                            <input type="number"
                                   name="adultos"
                                   class="input-premium w-50"
                                   placeholder="Adultos" />

                            <input type="number"
                                   name="criancas"
                                   class="input-premium w-50"
                                   placeholder="Crianças" />

                        </div>
                    </div>

                </div>
            </div>

            <!-- DETALHES -->
            <div class="card-secao">
                <div class="titulo-secao-premium">
                    <i class="fas fa-comment-dots"></i>
                    <h3>Desejos Especiais</h3>
                </div>

                <div class="group-premium">
                    <label>O que não pode faltar?</label>

                    <textarea name="desejosEspeciais"
                              class="input-premium"
                              rows="5"></textarea>
                </div>
            </div>

            <button type="submit" class="btn-enviar">
                Enviar Planejamento
            </button>

        </form>

    </div>
</div>

