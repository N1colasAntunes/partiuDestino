<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Partiu Destino</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>

        /* ── NAVBAR ── */
        .navbar-figma {
            background-color: #ffffff;
            padding: 0;
            border-bottom: 1px solid #e5e7eb;
            box-shadow: 0 2px 12px rgba(30, 58, 138, 0.08);
            height: 68px;
        }

            .navbar-figma .container {
                height: 100%;
            }

        /* ── LOGO ── */
        .navbar-brand-figma {
            display: flex;
            align-items: center;
            text-decoration: none;
            margin-right: 40px;
            padding: 0;
            flex-shrink: 0;
        }

        .logo-navbar {
            height: 120px;
            width: auto;
            object-fit: contain;
            display: block;
        }

        .navbar-brand-figma span {
            display: none;
        }

        /* ── LINKS ── */
        .nav-link-figma {
            color: #374151 !important;
            font-weight: 500;
            font-size: 0.88rem;
            padding: 6px 2px !important;
            margin: 0 14px;
            white-space: nowrap;
            position: relative;
            transition: color 0.2s;
            text-decoration: none;
        }

            .nav-link-figma::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -2px;
                width: 0;
                height: 2px;
                background: #3b82f6;
                border-radius: 2px;
                transition: width 0.25s;
            }

            .nav-link-figma:hover {
                color: #1e3a8a !important;
            }

                .nav-link-figma:hover::after {
                    width: 100%;
                }

            /* ── LINK ATIVO ── */
            .nav-link-figma.ativo {
                color: #1e3a8a !important;
                font-weight: 700;
            }

                .nav-link-figma.ativo::after {
                    width: 100%;
                    background: #1e3a8a;
                }

        /* ── BOTÃO ENTRAR / SAIR ── */
        .btn-entrar-nav {
            background-color: #1e3a8a;
            color: white !important;
            padding: 8px 22px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.88rem;
            text-decoration: none;
            transition: background 0.2s, transform 0.15s;
            display: inline-block;
            white-space: nowrap;
        }

            .btn-entrar-nav:hover {
                background-color: #1e40af;
                transform: translateY(-1px);
            }

        /* ── FOOTER ── */
        .footer-figma {
            background-color: #1e3a8a;
            color: white;
            padding: 30px 0;
            text-align: center;
            font-size: 0.85rem;
        }

        .footer-links-sociais {
            margin-bottom: 15px;
            display: flex;
            justify-content: center;
            gap: 20px;
            align-items: center;
        }

            .footer-links-sociais a {
                color: white;
                text-decoration: none;
            }

        /* ── HEADER FIXO ── */
        .navbar-sticky {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
        }

        main[role="main"] {
            padding-top: 68px;
        }
        /* ════════════════════════════════════════
           RESPONSIVIDADE - MENU LATERAL (MOBILE/TABLET)
           ════════════════════════════════════════ */
        @@media (max-width: 991.98px) {

            .navbar-figma .container {
                position: relative;
                justify-content: space-between;
            }

            .logo-navbar {
                height: 80px;
            }

            .navbar-toggler {
                border: none;
                padding: 6px 10px;
                box-shadow: none !important;
            }

                .navbar-toggler:focus {
                    box-shadow: none;
                }
            /* Painel lateral (off-canvas) */
            .navbar-collapse {
                position: fixed;
                top: 68px;
                right: 0;
                height: calc(100vh - 68px);
                width: min(78vw, 320px);
                background: #ffffff;
                flex-direction: column;
                align-items: stretch !important;
                justify-content: flex-start;
                padding: 24px 28px;
                box-shadow: -8px 0 30px rgba(15, 23, 42, 0.15);
                transform: translateX(100%);
                transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: 1001;
                overflow-y: auto;
            }

                .navbar-collapse.show {
                    transform: translateX(0);
                }

            .navbar-nav {
                width: 100%;
            }

            .nav-link-figma {
                display: block;
                margin: 0;
                padding: 14px 4px !important;
                border-bottom: 1px solid #f1f5f9;
                font-size: 1rem;
            }

             

                .nav-link-figma.ativo {
                    color: #1e3a8a !important;
                    background: #eff6ff;
                    padding-left: 12px !important;
                    border-radius: 6px;
                }

            .navbar-collapse > .d-flex {
                width: 100%;
                flex-direction: column;
                align-items: stretch !important;
                gap: 14px !important;
                margin-top: 24px;
                padding-top: 20px;
                border-top: 1px solid #f1f5f9;
            }

                .navbar-collapse > .d-flex a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    width: 100%;
                }

                    .navbar-collapse > .d-flex a[title="Meu Carrinho"]::after {
                        content: "Carrinho";
                        font-size: 0.95rem;
                        color: #374151;
                        font-weight: 500;
                    }

                    .navbar-collapse > .d-flex a[title="Meu Perfil"]::after {
                        content: "Meu Perfil";
                        font-size: 0.95rem;
                        color: #374151;
                        font-weight: 500;
                    }

                .navbar-collapse > .d-flex span {
                    position: static !important;
                    margin-left: auto;
                }

                .navbar-collapse > .d-flex .btn-entrar-nav {
                    text-align: center;
                    padding: 10px 22px;
                }
        }

        @@media (max-width: 380px) {
            .navbar-collapse {
                width: 86vw;
            }

            .logo-navbar {
                height: 64px;
            }
        }
    </style>
</head>
<body>

    <header class="navbar-sticky">
        <nav class="navbar navbar-expand-lg navbar-light navbar-figma">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand navbar-brand-figma" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logonav.png" alt="Partiu Destino" class="logo-navbar" />
                    <span>Partiu Destino</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-figma @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "ativo" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-figma @(ViewContext.RouteData.Values["controller"]?.ToString() == "Destinos" ? "ativo" : "")"
                               asp-controller="Destinos" asp-action="Index">Passagens</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-figma @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pacotes" ? "ativo" : "")"
                               asp-controller="Pacotes" asp-action="Index">Pacotes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-figma @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personalizada" ? "ativo" : "")"
                               asp-controller="Personalizada" asp-action="Index">Viagem Personalizada</a>
                        </li>

                        @if (Context.Session.GetString("UserRole") == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-figma @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "ativo" : "")"
                                   asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">

                        @if (Context.Session.GetString("UserName") != null)
                        {
                            int totalCarrinho = 0;
                            try
                            {
                                string connStr = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
                                int? uid = Context.Session.GetInt32("UserId");
                                if (uid != null)
                                {
                                    using var conn = new MySql.Data.MySqlClient.MySqlConnection(connStr);
                                    conn.Open();
                                    var cmd = new MySql.Data.MySqlClient.MySqlCommand(
                                    "SELECT COALESCE(SUM(quantidade),0) FROM carrinho WHERE usuario_id = @uid", conn);
                                    cmd.Parameters.AddWithValue("@uid", uid);
                                    totalCarrinho = Convert.ToInt32(cmd.ExecuteScalar());
                                }
                            }
                            catch { }

                            <a asp-controller="Carrinho"
                               asp-action="Index"
                               style="position:relative;color:#1e3a8a;font-size:1.3rem;text-decoration:none;"
                               title="Meu Carrinho">
                                <i class="fas fa-shopping-cart"></i>
                                @if (totalCarrinho > 0)
                                {
                                    <span style="position:absolute;top:-8px;right:-10px;
                                          background:#ef4444;color:white;font-size:.6rem;font-weight:800;
                                          width:18px;height:18px;border-radius:50%;
                                          display:flex;align-items:center;justify-content:center;">
                                        @(totalCarrinho > 9 ? "9+" : totalCarrinho.ToString())
                                    </span>
                                }
                            </a>

                            <a asp-controller="Perfil"
                               asp-action="Index"
                               style="color:#1e3a8a;font-size:1.4rem;text-decoration:none;"
                               title="Meu Perfil">
                                <i class="fas fa-user-circle"></i>
                            </a>

                            <a asp-controller="Login" asp-action="Logout" class="btn-entrar-nav">Sair</a>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn-entrar-nav">Entrar</a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/scroll-to-top.js" asp-append-version="true"></script>



    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
