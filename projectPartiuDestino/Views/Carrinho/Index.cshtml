@model IEnumerable<projectPartiuDestino.Models.CarrinhoItem>

@{
    ViewData["Title"] = "Meu Carrinho";
    decimal total = Model?.Sum(i => i.Subtotal) ?? 0;
    int totalItens = Model?.Sum(i => i.Quantidade) ?? 0;
    var pacotes = Model?.Where(i => i.TipoItem == "pacote") ?? Enumerable.Empty<projectPartiuDestino.Models.CarrinhoItem>();
    var destinos = Model?.Where(i => i.TipoItem == "destino") ?? Enumerable.Empty<projectPartiuDestino.Models.CarrinhoItem>();
    var personalizadas = Model?.Where(i => i.TipoItem == "viagem_personalizada") ?? Enumerable.Empty<projectPartiuDestino.Models.CarrinhoItem>();
}

<style>
    /* ───────────────────────────── reset / tokens ── */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --azul: #1e3a8a;
        --azul-mid: #2563eb;
        --azul-soft: #eff6ff;
        --verde: #059669;
        --verde-soft: #ecfdf5;
        --laranja: #d97706;
        --lj-soft: #fffbeb;
        --vermelho: #dc2626;
        --txt: #111827;
        --txt-sub: #6b7280;
        --borda: #e5e7eb;
        --bg: #f3f4f6;
        --card: #ffffff;
        --r-sm: 8px;
        --r-md: 12px;
        --r-lg: 16px;
    }

    /* ───────────────────────────── página ── */
    .cp {
        background: var(--bg);
        min-height: 100vh;
        padding-bottom: 64px;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        color: var(--txt);
    }

    /* ───────────────────────────── faixa topo ── */
    .cp-faixa {
        background: var(--azul);
        padding: 30px 0 52px;
    }

    .cp-faixa-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cp-faixa h1 {
        font-size: 1.55rem;
        font-weight: 700;
        color: #fff;
        line-height: 1.3;
    }

    .cp-faixa-sub {
        font-size: .82rem;
        color: rgba(255,255,255,.7);
        margin-top: 4px;
    }

    .cp-faixa-badge {
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: .76rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
        white-space: nowrap;
    }

    /* ───────────────────────────── corpo ── */
    .cp-body {
        max-width: 1080px;
        margin: -28px auto 0;
        padding: 0 20px;
        display: grid;
        grid-template-columns: minmax(0,1fr) 308px;
        gap: 20px;
        align-items: start;
    }

    /* ───────────────────────────── barra de nav ── */
    .cp-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--azul-mid);
        text-decoration: none;
        padding: 7px 13px;
        border: 1px solid var(--borda);
        border-radius: var(--r-sm);
        background: var(--card);
        transition: background .15s, border-color .15s;
    }

        .btn-back:hover {
            background: var(--azul-soft);
            border-color: #bfdbfe;
        }

    .cp-nav-info {
        font-size: .78rem;
        color: var(--txt-sub);
    }

    /* ───────────────────────────── alertas ── */
    .alerta {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: var(--r-md);
        font-size: .84rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .alerta-ok {
        background: #f0fdf4;
        border: 1px solid #86efac;
        color: #166534;
    }

    .alerta-err {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    /* ───────────────────────────── card de item ── */
    .item {
        background: var(--card);
        border: 1px solid var(--borda);
        border-radius: var(--r-lg);
        margin-bottom: 12px;
        overflow: hidden;
    }

    /* linha superior colorida de acento */
    .item-acento {
        height: 3px;
    }

        .item-acento.pac {
            background: var(--azul);
        }

        .item-acento.dest {
            background: var(--verde);
        }

        .item-acento.pers {
            background: var(--laranja);
        }

    .item-corpo {
        padding: 18px 20px 0;
    }

    /* cabeçalho: ícone + texto + valor */
    .item-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .item-ic {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .ic-pac {
        background: var(--azul-soft);
        color: var(--azul);
    }

    .ic-dest {
        background: var(--verde-soft);
        color: var(--verde);
    }

    .ic-pers {
        background: var(--lj-soft);
        color: var(--laranja);
    }

    .item-texto {
        flex: 1;
        min-width: 0;
    }

    .item-badge {
        display: inline-flex;
        align-items: center;
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .55px;
        padding: 2px 9px;
        border-radius: 20px;
        margin-bottom: 5px;
    }

    .ib-pac {
        background: var(--azul-soft);
        color: #1d4ed8;
    }

    .ib-dest {
        background: var(--verde-soft);
        color: #065f46;
    }

    .ib-pers {
        background: var(--lj-soft);
        color: #92400e;
    }

    .item-nome {
        font-size: .94rem;
        font-weight: 600;
        color: var(--txt);
        line-height: 1.45;
        margin-bottom: 4px;
    }

    .item-dt {
        font-size: .73rem;
        color: var(--txt-sub);
    }

    .item-preco-bloco {
        text-align: right;
        flex-shrink: 0;
    }

    .item-preco-lbl {
        font-size: .68rem;
        color: var(--txt-sub);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 2px;
    }

    .item-preco-val {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--azul);
        line-height: 1.1;
    }

    .item-preco-unit {
        font-size: .72rem;
        color: var(--txt-sub);
        margin-top: 3px;
    }

    .item-preco-orcamento {
        font-size: .8rem;
        font-weight: 600;
        color: var(--laranja);
    }

    /* separador de info */
    .item-sep {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        margin-top: 16px;
        border-top: 1px solid var(--borda);
    }

    .item-sep-col {
        padding: 11px 0;
        border-right: 1px solid var(--borda);
    }

        .item-sep-col:last-child {
            border-right: none;
        }

    .isc-lbl {
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .45px;
        color: var(--txt-sub);
        margin-bottom: 4px;
    }

    .isc-val {
        font-size: .85rem;
        font-weight: 600;
        color: var(--txt);
    }

    /* rodapé do card */
    .item-rodape {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 20px;
        background: #fafafa;
        border-top: 1px solid var(--borda);
        flex-wrap: wrap;
    }

    .qtd-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qtd-lbl {
        font-size: .78rem;
        color: var(--txt-sub);
        font-weight: 600;
    }

    .qtd-ctrl {
        display: flex;
        align-items: center;
        border: 1px solid var(--borda);
        border-radius: var(--r-sm);
        overflow: hidden;
        background: var(--card);
        height: 32px;
    }

    .qtd-btn {
        width: 32px;
        height: 32px;
        border: none;
        background: none;
        color: var(--azul);
        font-size: .95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .12s;
    }

        .qtd-btn:hover {
            background: var(--azul-soft);
        }

    .qtd-divider {
        width: 1px;
        height: 32px;
        background: var(--borda);
    }

    .qtd-n {
        min-width: 34px;
        text-align: center;
        font-size: .88rem;
        font-weight: 700;
        color: var(--txt);
    }

    .rodape-dir {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-ok {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: .74rem;
        color: var(--verde);
        font-weight: 600;
    }

    .status-orcamento {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: .74rem;
        color: var(--laranja);
        font-weight: 600;
    }

    .btn-rm {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .76rem;
        font-weight: 600;
        color: var(--vermelho);
        background: #fff;
        border: 1px solid #fecaca;
        border-radius: 7px;
        padding: 6px 12px;
        cursor: pointer;
        transition: background .12s;
    }

        .btn-rm:hover {
            background: #fef2f2;
        }

    /* ───────────────────────────── vazio ── */
    .vazio {
        background: var(--card);
        border: 1.5px dashed #d1d5db;
        border-radius: var(--r-lg);
        text-align: center;
        padding: 60px 24px;
    }

        .vazio i {
            font-size: 2.8rem;
            color: #d1d5db;
            display: block;
            margin-bottom: 16px;
        }

        .vazio h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--txt);
            margin-bottom: 8px;
        }

        .vazio p {
            font-size: .84rem;
            color: var(--txt-sub);
            line-height: 1.65;
            max-width: 400px;
            margin: 0 auto 22px;
        }

    .vazio-btns {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .vazio-btns a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: .84rem;
            font-weight: 700;
            text-decoration: none;
            color: #fff;
        }

    .vb-pac {
        background: var(--azul);
    }

    .vb-dest {
        background: var(--verde);
    }

    /* ───────────────────────────── sidebar resumo ── */
    .resumo {
        background: var(--card);
        border: 1px solid var(--borda);
        border-radius: var(--r-lg);
        overflow: hidden;
        position: sticky;
        top: 16px;
    }

    .resumo-topo {
        background: var(--azul);
        padding: 16px 20px;
    }

    .resumo-topo-label {
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: rgba(255,255,255,.6);
        margin-bottom: 3px;
    }

    .resumo-topo h3 {
        font-size: .98rem;
        font-weight: 700;
        color: #fff;
    }

    .resumo-corpo {
        padding: 18px 20px;
    }

    /* itens listados no resumo */
    .res-itens {
        margin-bottom: 16px;
    }

    .res-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid #f3f4f6;
        font-size: .82rem;
    }

        .res-item:last-child {
            border-bottom: none;
        }

    .res-item-esq {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        min-width: 0;
    }

    .res-item-ic {
        font-size: .82rem;
        margin-top: 1px;
        flex-shrink: 0;
    }

    .res-item-nome {
        font-size: .8rem;
        font-weight: 600;
        color: var(--txt);
        line-height: 1.35;
    }

    .res-item-qtd {
        font-size: .72rem;
        color: var(--txt-sub);
        margin-top: 1px;
    }

    .res-item-val {
        font-size: .84rem;
        font-weight: 700;
        color: var(--txt);
        white-space: nowrap;
    }

    /* totalizador */
    .res-total-bloco {
        background: #f9fafb;
        border: 1px solid var(--borda);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 16px;
    }

    .res-t-linha {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .82rem;
        color: var(--txt-sub);
        padding: 5px 0;
        border-bottom: 1px dashed #e5e7eb;
    }

        .res-t-linha:last-child {
            border-bottom: none;
        }

        .res-t-linha .rv {
            color: var(--txt);
            font-weight: 600;
        }

    .res-t-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 2px solid var(--borda);
    }

        .res-t-total .tl {
            font-size: .9rem;
            font-weight: 700;
            color: var(--txt);
        }

        .res-t-total .tv {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--azul);
        }

    /* aviso */
    .res-aviso {
        background: var(--lj-soft);
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 10px 13px;
        font-size: .75rem;
        color: #92400e;
        line-height: 1.5;
        margin-bottom: 14px;
    }

    /* botões resumo */
    .btn-pagar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        background: var(--azul);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: .92rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-pagar:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .btn-esvaziar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        background: var(--card);
        color: var(--txt-sub);
        border: 1px solid var(--borda);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
        transition: border-color .15s, color .15s;
    }

        .btn-esvaziar:hover {
            border-color: #fca5a5;
            color: var(--vermelho);
            background: #fef2f2;
        }

    /* explorar */
    .res-explorar {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid var(--borda);
    }

    .res-explorar-titulo {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--txt-sub);
        text-align: center;
        margin-bottom: 10px;
    }

    .exp-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .exp-a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        background: #f9fafb;
        border: 1px solid var(--borda);
        border-radius: 8px;
        padding: 9px 6px;
        text-decoration: none;
        font-size: .7rem;
        font-weight: 700;
        transition: background .12s;
    }

        .exp-a i {
            font-size: .95rem;
        }

        .exp-a:hover {
            background: #f3f4f6;
        }

    .exp-pac {
        color: var(--azul);
    }

    .exp-dest {
        color: var(--verde);
    }

    .exp-pers {
        color: var(--laranja);
    }

    /* ───────────────────────────── responsivo ── */
    @@media (max-width: 920px) {
        .cp-body {
            grid-template-columns: 1fr;
        }

        .resumo {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .item-sep {
            grid-template-columns: 1fr 1fr;
        }

        .item-sep-col:nth-child(2) {
            border-right: none;
        }

        .item-sep-col:last-child {
            grid-column: 1/-1;
            border-top: 1px solid var(--borda);
        }

        .item-head {
            flex-wrap: wrap;
        }

        .item-preco-bloco {
            margin-top: 8px;
            border-top: 1px solid var(--borda);
            padding-top: 8px;
            width: 100%;
            text-align: left;
        }

        .cp-faixa h1 {
            font-size: 1.3rem;
        }

        .item-rodape {
            flex-direction: column;
            align-items: stretch;
        }

        .rodape-dir {
            justify-content: space-between;
        }
    }
</style>

<div class="cp">

    @* FAIXA TOPO *@
    <div class="cp-faixa">
        <div class="cp-faixa-inner">
            <div>
                <h1>Meu carrinho de reservas</h1>
                <div class="cp-faixa-sub">Revise os itens e ajuste antes de prosseguir para o pagamento</div>
            </div>
            @if (Model != null && Model.Any())
            {
                <span class="cp-faixa-badge">@totalItens @(totalItens == 1 ? "item" : "itens") no carrinho</span>
            }
        </div>
    </div>

    <div class="cp-body">

        @* COLUNA ITENS *@
        <div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alerta alerta-ok">
                    <i class="fas fa-check-circle"></i>
                    <span>@TempData["Sucesso"]</span>
                </div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="alerta alerta-err">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@TempData["Erro"]</span>
                </div>
            }

            <div class="cp-nav">
                <a asp-controller="Pacotes" asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                    Continuar escolhendo
                </a>
     
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="vazio">
                    <i class="fas fa-shopping-cart"></i>
                    <h3>Seu carrinho está vazio</h3>
                    <p>Explore nossos pacotes e destinos para planejar sua próxima viagem.</p>
                    <div class="vazio-btns">
                        <a asp-controller="Pacotes" asp-action="Index" class="vb-pac">
                            <i class="fas fa-suitcase-rolling"></i> Ver pacotes
                        </a>
                        <a asp-controller="Destinos" asp-action="Index" class="vb-dest">
                            <i class="fas fa-map-marker-alt"></i> Ver destinos
                        </a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    string acentoCss = item.TipoItem switch
                    {
                        "pacote" => "pac",
                        "destino" => "dest",
                        "viagem_personalizada" => "pers",
                        _ => "pac"
                    };
                    string icCss = item.TipoItem switch
                    {
                        "pacote" => "ic-pac",
                        "destino" => "ic-dest",
                        "viagem_personalizada" => "ic-pers",
                        _ => "ic-pac"
                    };
                    string icFA = item.TipoItem switch
                    {
                        "pacote" => "fa-plane-departure",
                        "destino" => "fa-map-marker-alt",
                        "viagem_personalizada" => "fa-magic",
                        _ => "fa-ticket-alt"
                    };
                    string badgeCss = item.TipoItem switch
                    {
                        "pacote" => "ib-pac",
                        "destino" => "ib-dest",
                        "viagem_personalizada" => "ib-pers",
                        _ => "ib-pac"
                    };
                    string labelTipo = item.TipoItem switch
                    {
                        "pacote" => "Pacote",
                        "destino" => "Passagem / Destino",
                        "viagem_personalizada" => "Viagem personalizada",
                        _ => item.TipoItem
                    };
                    string valorUnit = item.PrecoUnitario > 0 ? item.PrecoUnitario.ToString("C") : "A combinar";

                    <div class="item">
                        <div class="item-acento @acentoCss"></div>

                        <div class="item-corpo">
                            <div class="item-head">
                                <div class="item-ic @icCss">
                                    <i class="fas @icFA"></i>
                                </div>

                                <div class="item-texto">
                                    <span class="item-badge @badgeCss">@labelTipo</span>
                                    <div class="item-nome">@item.NomeItem</div>
                                    <div class="item-dt">
                                        <i class="far fa-clock" style="margin-right:3px;"></i>
                                        Adicionado em @item.DataAdicionado.ToString("dd/MM/yyyy 'às' HH:mm")
                                    </div>
                                </div>

                                <div class="item-preco-bloco">
                                    <div class="item-preco-lbl">Subtotal</div>
                                    @if (item.PrecoUnitario > 0)
                                    {
                                        <div class="item-preco-val">@item.Subtotal.ToString("C")</div>
                                        <div class="item-preco-unit">@item.PrecoUnitario.ToString("C") / unidade</div>
                                    }
                                    else
                                    {
                                        <div class="item-preco-orcamento">
                                            <i class="fas fa-headset" style="margin-right:3px;"></i>Sob consulta
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="item-sep">
                                <div class="item-sep-col">
                                    <div class="isc-lbl">Tipo</div>
                                    <div class="isc-val">@labelTipo</div>
                                </div>
                                <div class="item-sep-col" style="padding-left:16px;">
                                    <div class="isc-lbl">Quantidade</div>
                                    <div class="isc-val">@item.Quantidade @(item.Quantidade > 1 ? "viajantes" : "viajante")</div>
                                </div>
                                <div class="item-sep-col" style="padding-left:16px;">
                                    <div class="isc-lbl">Valor unitário</div>
                                    <div class="isc-val">@valorUnit</div>
                                </div>
                            </div>
                        </div>

                        <div class="item-rodape">
                            @if (item.TipoItem != "viagem_personalizada")
                            {
                                <div class="qtd-wrap">
                                    <span class="qtd-lbl">Qtd.</span>
                                    <div class="qtd-ctrl">
                                        <form asp-action="AlterarQuantidade" method="post" style="margin:0;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="delta" value="-1" />
                                            <button type="submit" class="qtd-btn" title="Diminuir">−</button>
                                        </form>
                                        <div class="qtd-divider"></div>
                                        <span class="qtd-n">@item.Quantidade</span>
                                        <div class="qtd-divider"></div>
                                        <form asp-action="AlterarQuantidade" method="post" style="margin:0;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="delta" value="1" />
                                            <button type="submit" class="qtd-btn" title="Aumentar">+</button>
                                        </form>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="status-orcamento">
                                    <i class="fas fa-headset"></i>
                                    Aguardando orçamento da equipe
                                </span>
                            }

                            <div class="rodape-dir">
                                <span class="status-ok">
                                    <i class="fas fa-check-circle"></i>
                                    Pronto para pagamento
                                </span>
                                <form asp-action="Remover" method="post" style="margin:0;"
                                      onsubmit="return confirm('Remover este item do carrinho?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-rm">
                                        <i class="fas fa-trash-alt"></i> Remover
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>

        @* SIDEBAR RESUMO *@
        @if (Model != null && Model.Any())
        {
            <aside>
                <div class="resumo">

                    <div class="resumo-topo">
                        <div class="resumo-topo-label">Resumo da compra</div>
                        <h3>Sua reserva</h3>
                    </div>

                    <div class="resumo-corpo">

                       
                         

                        <div class="res-total-bloco">
                            @if (pacotes.Any())
                            {
                                <div class="res-t-linha">
                                    <span>
                                        <i class="fas fa-plane-departure" style="color:var(--azul);margin-right:5px;"></i>
                                        Pacotes (@pacotes.Sum(i => i.Quantidade)x)
                                    </span>
                                    <span class="rv">@pacotes.Sum(i => i.Subtotal).ToString("C")</span>
                                </div>
                            }
                            @if (destinos.Any())
                            {
                                <div class="res-t-linha">
                                    <span>
                                        <i class="fas fa-map-marker-alt" style="color:var(--verde);margin-right:5px;"></i>
                                        Destinos (@destinos.Sum(i => i.Quantidade)x)
                                    </span>
                                    <span class="rv">@destinos.Sum(i => i.Subtotal).ToString("C")</span>
                                </div>
                            }
                            @if (personalizadas.Any())
                            {
                                <div class="res-t-linha">
                                    <span>
                                        <i class="fas fa-magic" style="color:var(--laranja);margin-right:5px;"></i>
                                        Personalizadas
                                    </span>
                                    <span class="rv" style="color:var(--laranja);">A orçar</span>
                                </div>
                            }
                            <div class="res-t-linha">
                                <span>Total de itens</span>
                                <span class="rv">@totalItens</span>
                            </div>
                            <div class="res-t-total">
                                <span class="tl">Total estimado</span>
                                <span class="tv">@total.ToString("C")</span>
                            </div>
                        </div>

                        @if (personalizadas.Any())
                        {
                            <div class="res-aviso">
                                <i class="fas fa-info-circle" style="margin-right:5px;"></i>
                                Viagens personalizadas serão confirmadas após análise da equipe.
                            </div>
                        }

                        <a href="/Pagamento/Index" class="btn-pagar">
                            <i class="fas fa-lock"></i>
                            Ir para pagamento
                        </a>

                        <form asp-action="Limpar" method="post"
                              onsubmit="return confirm('Deseja esvaziar todo o carrinho?');">
                            <button type="submit" class="btn-esvaziar">
                                <i class="fas fa-trash"></i>
                                Esvaziar carrinho
                            </button>
                        </form>

                        <div class="res-explorar">
                            <div class="res-explorar-titulo">Continue explorando</div>
                            <div class="exp-grid">
                                <a asp-controller="Pacotes" asp-action="Index" class="exp-a exp-pac">
                                    <i class="fas fa-suitcase-rolling"></i>
                                    Pacotes
                                </a>
                                <a asp-controller="Destinos" asp-action="Index" class="exp-a exp-dest">
                                    <i class="fas fa-globe-americas"></i>
                                    Destinos
                                </a>
                                <a asp-controller="Personalizada" asp-action="Index" class="exp-a exp-pers">
                                    <i class="fas fa-magic"></i>
                                    Personalizada
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </aside>
        }

    </div>
</div>