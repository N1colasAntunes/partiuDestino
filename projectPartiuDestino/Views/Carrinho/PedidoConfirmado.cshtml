@model List<projectPartiuDestino.Models.ResumoPedidoItem>
@{
    ViewData["Title"] = "Pedido Confirmado";
    decimal totalGeral = Model?.Sum(i => i.Subtotal) ?? 0;
}

<style>
    .conf-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 60px 0;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .conf-card {
        max-width: 700px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .conf-icone {
        width: 70px;
        height: 70px;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 20px;
    }

    .conf-card h1 {
        text-align: center;
        font-size: 1.6rem;
        font-weight: 900;
        color: #1e3a8a;
        margin-bottom: 6px;
    }

    .conf-card p.sub {
        text-align: center;
        color: #6b7280;
        margin-bottom: 30px;
    }

    .item-resumo {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .item-resumo:last-child {
            border-bottom: none;
        }

    .item-nome {
        font-weight: 700;
        color: #1f2937;
        font-size: .92rem;
    }

    .item-tipo {
        font-size: .72rem;
        color: #6b7280;
        text-transform: uppercase;
        font-weight: 700;
    }

    .item-valor {
        font-weight: 800;
        color: #1e3a8a;
        white-space: nowrap;
    }

    .total-final {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #e5e7eb;
        font-size: 1.2rem;
        font-weight: 900;
        color: #1e3a8a;
    }

    .btn-voltar-home {
        display: block;
        text-align: center;
        margin-top: 30px;
        background: #1e3a8a;
        color: white;
        padding: 14px;
        border-radius: 12px;
        font-weight: 800;
        text-decoration: none;
    }
</style>

<div class="conf-page">
    <div class="conf-card">
        <div class="conf-icone"><i class="fas fa-check"></i></div>
        <h1>Pedido confirmado!</h1>
        <p class="sub">Seu pedido foi registrado com sucesso. Confira o resumo abaixo.</p>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="item-resumo">
                    <div>
                        <div class="item-tipo">@item.TipoItem</div>
                        <div class="item-nome">@item.NomeItem</div>
                        <div style="font-size:.8rem;color:#6b7280;">Qtd: @item.Quantidade</div>
                    </div>
                    <div class="item-valor">@item.Subtotal.ToString("C")</div>
                </div>
            }

            <div class="total-final">
                <span>Total</span>
                <span>@totalGeral.ToString("C")</span>
            </div>
        }
        else
        {
            <p style="text-align:center;color:#6b7280;">Nenhum item encontrado para este pedido.</p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn-voltar-home">Voltar para o início</a>
    </div>
</div>