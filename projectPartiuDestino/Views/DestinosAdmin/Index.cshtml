@{
    ViewData["Title"] = "Destinos - Painel Administrativo";
}
@using MySql.Data.MySqlClient

@{
    string conexao = "server=localhost;database=bdpartiudestino;uid=root;pwd=12345678;";
}

<style>
    .admin-wrapper {
        display: flex;
        min-height: 100vh;
        background-color: #f8fafc;
    }

    .admin-sidebar {
        width: 260px;
        background-color: #1e3a8a;
        color: white;
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }

    .sidebar-header {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 40px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: white;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        flex-grow: 1;
    }

    .sidebar-item {
        margin-bottom: 10px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 15px;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.3s;
        font-weight: 500;
    }

        .sidebar-link:hover, .sidebar-link.ativo {
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
        }

        .sidebar-link i {
            width: 20px;
            text-align: center;
        }

    .admin-main {
        flex-grow: 1;
        padding: 40px;
        overflow-x: auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .admin-header h2 {
            font-weight: 800;
            color: #1e3a8a;
            margin: 0;
            font-size: 1.6rem;
        }

    .metric-card-small {
        background: white;
        padding: 20px 25px;
        border-radius: 14px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
        display: inline-flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .metric-icon-sm {
        width: 48px;
        height: 48px;
        background: #eff6ff;
        color: #3b82f6;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .metric-info h4 {
        margin: 0 0 4px;
        color: #64748b;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .metric-info p {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1e3a8a;
        line-height: 1;
    }

    .btn-novo {
        background: #16a34a;
        color: white;
        padding: 10px 18px;
        text-decoration: none;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 24px;
        transition: background 0.2s;
    }

        .btn-novo:hover {
            background: #15803d;
            color: white;
        }

    .admin-table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            background-color: #1e3a8a;
            color: white;
            text-align: left;
            padding: 14px 18px;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .admin-table td {
            padding: 13px 18px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            font-size: 0.9rem;
        }

        .admin-table tr:hover td {
            background-color: #f8fafc;
        }

    @@media (max-width: 992px) {
        .admin-sidebar {
            width: 80px;
            padding: 30px 10px;
        }

        .sidebar-header span, .sidebar-link span {
            display: none;
        }

        .sidebar-header {
            justify-content: center;
        }

        .sidebar-link {
            justify-content: center;
        }
    }
</style>

<div class="admin-wrapper">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <i class="fas fa-plane"></i>
            <span>Partiu Destino</span>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/Admin/Index" class="sidebar-link">
                    <i class="fas fa-chart-pie"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/DestinosAdmin/Index" class="sidebar-link ativo">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>Destinos</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/PacotesAdmin/Index" class="sidebar-link">
                    <i class="fas fa-suitcase-rolling"></i>
                    <span>Pacotes</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/ViagemPersonalizadaAdmin/Index" class="sidebar-link">
                    <i class="fas fa-globe-americas"></i>
                    <span>Viagens Personalizadas</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/Usuarios/Index" class="sidebar-link">
                    <i class="fas fa-users"></i>
                    <span>Usuários</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/PedidosFinalizados/Index" class="sidebar-link">
                    <i class="fas fa-check-circle"></i>
                    <span>Pedidos Finalizados</span>
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>Sair do Painel</span>
            </a>
        </div>
    </aside>

    <!-- Conteúdo Principal -->
    <main class="admin-main">
        <div class="admin-header">
            <h2><i class="fas fa-map-marked-alt me-2"></i>Destinos Cadastrados</h2>
        </div>

        <!-- Métrica -->
        <div class="metric-card-small">
            <div class="metric-icon-sm"><i class="fas fa-globe-americas"></i></div>
            <div class="metric-info">
                <h4>Destinos Ativos</h4>
                <p>
                    @{
                        int totalDestinos = 0;
                        using (MySqlConnection conn = new MySqlConnection(conexao))
                        {
                            conn.Open();
                            string sqlTotal = "SELECT COUNT(*) FROM destinos";
                            MySqlCommand cmdTotal = new MySqlCommand(sqlTotal, conn);
                            totalDestinos = Convert.ToInt32(cmdTotal.ExecuteScalar());
                        }
                    }
                    @totalDestinos
                </p>
            </div>
        </div>

        <!-- Botão Novo -->
        <div>
            <a asp-controller="DestinosAdmin" asp-action="Criar" class="btn-novo">
                <i class="fas fa-plus"></i> Novo Destino
            </a>
        </div>

        <!-- Tabela -->
        <div class="admin-table-card">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Origem País</th>
                        <th>Origem Estado</th>
                        <th>Destino País</th>
                        <th>Destino Estado</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        using (MySqlConnection conn = new MySqlConnection(conexao))
                        {
                            conn.Open();
                            string sql = "SELECT * FROM destinos ORDER BY id";
                            MySqlCommand cmd = new MySqlCommand(sql, conn);
                            MySqlDataReader reader = cmd.ExecuteReader();
                            while (reader.Read())
                            {
                                <tr>
                                    <td>@reader["id"]</td>
                                    <td>@reader["origem_pais"]</td>
                                    <td>@reader["origem_estado"]</td>
                                    <td>@reader["pais"]</td>
                                    <td>@reader["estado"]</td>
                                    <td style="display:flex;gap:8px;align-items:center;">
                                        <a asp-controller="DestinosAdmin"
                                           asp-action="Editar"
                                           asp-route-id="@reader["id"]"
                                           style="background:#2563eb;color:white;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:0.85rem;">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                        <form asp-action="Delete"
                                              asp-controller="DestinosAdmin"
                                              method="post"
                                              onsubmit="return confirm('Tem certeza que deseja excluir este destino?');"
                                              style="margin:0;">
                                            <input type="hidden" name="id" value="@reader["id"]" />
                                            <button type="submit"
                                                    style="background:#ef4444;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.85rem;">
                                                <i class="fas fa-trash"></i> Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
