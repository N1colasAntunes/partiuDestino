@{
    ViewData["Title"] = "Editar Destino";
}

<style>
    h2 {
        color: #1e3a8a;
        font-weight: 800;
        margin-bottom: 30px;
        position: relative;
        padding-bottom: 10px;
    }

        h2::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 4px;
            background: #3b82f6;
            border-radius: 2px;
        }

    .form-wrapper {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0e7ff;
        color: #1e3a8a;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        margin-bottom: 24px;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-voltar:hover {
            background: #c7d2fe;
        }

    form {
        background: white;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        align-items: start;
    }

        form div {
            margin-bottom: 0 !important;
            display: flex;
            flex-direction: column;
        }

    label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
        display: block;
        font-size: 0.9rem;
    }

    input[type="text"],
    input[type="number"] {
        width: 100% !important;
        padding: 12px 16px !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 10px !important;
        background-color: #f8fafc !important;
        font-size: 0.95rem;
        box-sizing: border-box !important;
        transition: all 0.2s;
    }

        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: #3b82f6 !important;
            background-color: #fff !important;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.1);
        }

    /* bloco da imagem */
    .imagem-bloco {
        grid-column: span 2;
        border: 2px dashed #c7d2fe;
        border-radius: 12px;
        padding: 20px;
        background: #f8faff;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

        .imagem-bloco > label {
            color: #1e3a8a;
            font-size: 1rem;
            font-weight: 700;
        }

        .imagem-bloco small {
            color: #64748b;
            font-size: .82rem;
        }

    .imagem-atual {
        display: flex;
        align-items: center;
        gap: 16px;
        background: white;
        border-radius: 10px;
        padding: 12px;
        border: 1px solid #e2e8f0;
    }

        .imagem-atual img {
            width: 100px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

    #previewImagem {
        width: 180px;
        height: 120px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid #c7d2fe;
        display: none;
    }

    .form-actions {
        grid-column: span 2;
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 10px;
    }

    button[type="submit"] {
        width: 100% !important;
        padding: 16px !important;
        background: #1e3a8a !important;
        color: white !important;
        border: none !important;
        border-radius: 12px !important;
        font-size: 1rem !important;
        font-weight: 700 !important;
        cursor: pointer;
        margin-top: 8px;
        transition: all 0.3s;
    }

        button[type="submit"]:hover {
            filter: brightness(1.15);
            transform: translateY(-1px);
        }
</style>

<div class="form-wrapper">
    <h2>Editar Destino</h2>

    <a class="btn-voltar" href="/DestinosAdmin/Index">&#8592; Voltar para Destinos</a>

    <!-- enctype="multipart/form-data" é OBRIGATÓRIO para o upload funcionar -->
    <form method="post" asp-action="Editar" enctype="multipart/form-data">

        <input type="hidden" name="id" value="@ViewBag.Id" />

        <!-- Guarda a imagem atual. Se o admin não enviar nova imagem,
             este valor é mantido no banco pelo controller. -->
        <input type="hidden" name="imagem_url" value="@ViewBag.ImagemUrl" />

        <div>
            <label>País de Origem</label>
            <input type="text" name="origem_pais" value="@ViewBag.OrigemPais" required />
        </div>

        <div>
            <label>Estado de Origem</label>
            <input type="text" name="origem_estado" value="@ViewBag.OrigemEstado" required />
        </div>

        <div>
            <label>País de Destino</label>
            <input type="text" name="pais" value="@ViewBag.Pais" required />
        </div>

        <div>
            <label>Estado de Destino</label>
            <input type="text" name="estado" value="@ViewBag.Estado" required />
        </div>

        <div style="grid-column:span 2">
            <label>Preço por Pessoa (R$)</label>
            <input type="number" step="0.01" name="preco_por_pessoa" value="@ViewBag.Preco" required />
        </div>

        <!-- BLOCO DA IMAGEM -->
        <div class="imagem-bloco">
            <label>🖼️ Imagem do Destino</label>

            <!-- Mostra a imagem que está salva atualmente -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.ImagemUrl as string))
            {
                <div class="imagem-atual">
                    <img src="@(ViewBag.ImagemUrl.ToString().StartsWith("http")
                                    ? ViewBag.ImagemUrl
                                    : "/" + ViewBag.ImagemUrl)"
                         alt="Imagem atual"
                         onerror="this.style.display='none'" />
                    <div>
                        <strong>Imagem atual</strong><br />
                        <small>@ViewBag.ImagemUrl</small>
                    </div>
                </div>
            }
            else
            {
                <small>⚠️ Nenhuma imagem cadastrada ainda.</small>
            }

            <!-- OPÇÃO 1: enviar arquivo novo (substitui a atual) -->
            <div>
                <label>Substituir por arquivo do computador</label>
                <input type="file" name="imagemArquivo" accept="image/*"
                       onchange="mostrarPreview(this)" />
                <small>Se enviar um arquivo novo, ele substitui a imagem atual.</small>
            </div>

            <!-- preview da nova imagem antes de salvar -->
            <img id="previewImagem" src="" alt="Preview da nova imagem" />
        </div>

        <div class="form-actions">
            <button type="submit">Salvar Alterações</button>
        </div>

    </form>
</div>

<script>
    function mostrarPreview(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.getElementById('previewImagem');
                img.src = e.target.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
